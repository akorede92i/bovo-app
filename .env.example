# Supabase
PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Kkiapay (acompte optionnel)
PUBLIC_KKIAPAY_PUBLIC_KEY=your-kkiapay-public-key
KKIAPAY_PRIVATE_KEY=your-kkiapay-private-key
# Secrets de l'Edge Function confirm-deposit (vérif paiement serveur). NE PAS
# préfixer PUBLIC_ (jamais exposés au navigateur). À poser via `supabase secrets set`,
# pas dans le build. Les 3 sont requises pour que la confirmation marque 'paid'.
KKIAPAY_PUBLIC_KEY=your-kkiapay-public-key
KKIAPAY_SECRET_KEY=your-kkiapay-secret-key
# Mode de l'API de vérification : false = prod (def), true = sandbox (= mode du widget)
KKIAPAY_SANDBOX=false
# Mode sandbox du widget (paiements de test). DÉFAUT SÛR = sandbox : on ne fait de
# VRAIS paiements que si PUBLIC_KKIAPAY_SANDBOX=false est posé EXPLICITEMENT (uniquement
# sur le build prod web — via deploy.yml — et les release mobiles). Dev/preprod/APK de
# test : laisser =true ou non défini → aucun débit réel possible par oubli.
PUBLIC_KKIAPAY_SANDBOX=true

# Notification WhatsApp admin
ADMIN_WHATSAPP=2290196677743
ADMIN_PHONE=2290197199185

# Google Sheets (optionnel, export résa)
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/xxx/exec
