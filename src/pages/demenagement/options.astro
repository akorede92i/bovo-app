---
import Layout from '@layouts/Layout.astro';
import Stepper from '@components/Stepper.astro';
import CtaFooter from '@components/CtaFooter.astro';
import Icon from '@components/Icon.astro';
import { DEM_OPTIONS, fcfa } from '@lib/catalog';
---
<Layout
  title="Déménagement — Étape 4 : Options | Bovo"
  topbar="back"
  backHref="/demenagement/arrivee/"
  pageTitle="Déménagement"
  noindex
  transitions
>
  <Fragment slot="topbar-extra"><Stepper total={7} current={4} /></Fragment>

  <h1 class="h-display" style="margin-bottom:8px;">Besoin d'aide en plus&nbsp;?</h1>
  <p class="text-lead" style="margin-bottom:24px;">Options facultatives pour un déménagement clé en main.</p>

  <div class="stack-sm" id="opt-list" role="group" aria-label="Options de déménagement">
    {DEM_OPTIONS.map((o) => (
      <button class="opt" data-value={o.id} data-price={o.priceXof} aria-pressed="false">
        <span class="opt-check"><Icon name="check" size={14} /></span>
        <span class="opt-body">
          <span class="opt-title">{o.label}</span>
          <span class="opt-meta">{o.meta}</span>
        </span>
        <span class="opt-price">+{fcfa(o.priceXof)}</span>
      </button>
    ))}
  </div>

  <CtaFooter buttonLabel="Continuer" buttonType="button" buttonId="cta-next" priceLabel="Estimation totale" priceValue="—" />
</Layout>

<script>
  import { loadState, saveState, type DemenagementState } from '@lib/state';
  import { DEM_VOLUMES, DEM_OPTIONS, DEM_ETAGE_SUPP_XOF, fcfa } from '@lib/catalog';
  import { navigate } from 'astro:transitions/client';

  function init() {
  if (!document.getElementById('opt-list')) return;

  const list = document.getElementById('opt-list')!;
  const cta = document.getElementById('cta-next') as HTMLButtonElement;
  const priceEl = document.querySelector('.cta-footer .price-line strong')!;

  const s = loadState<DemenagementState>('demenagement');
  let options = new Set<string>(s.options ?? []);

  function compute() {
    const vol = DEM_VOLUMES.find((v) => v.id === s.volume);
    const base = vol?.priceXof ?? 0;
    const opts = [...options].reduce((sum, id) => {
      const o = DEM_OPTIONS.find((x) => x.id === id);
      return sum + (o?.priceXof ?? 0);
    }, 0);
    const fromFloors = (!s.from?.elevator && s.from?.floor) ? s.from.floor : 0;
    const toFloors = (!s.to?.elevator && s.to?.floor) ? s.to.floor : 0;
    const floors = (fromFloors + toFloors) * DEM_ETAGE_SUPP_XOF;
    return base + opts + floors;
  }

  function render() {
    list.querySelectorAll<HTMLButtonElement>('.opt').forEach((el) => {
      const on = options.has(el.dataset.value!);
      el.classList.toggle('is-active', on);
      el.setAttribute('aria-pressed', on ? 'true' : 'false');
    });
    priceEl.textContent = fcfa(compute());
  }

  list.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.opt');
    if (!btn) return;
    const v = btn.dataset.value!;
    if (options.has(v)) options.delete(v); else options.add(v);
    saveState<DemenagementState>('demenagement', { options: [...options], estimatedTotal: compute() });
    render();
  });

  cta.addEventListener('click', () => {
    saveState<DemenagementState>('demenagement', { options: [...options], estimatedTotal: compute() });
    navigate('/demenagement/date/');
  });

  render();

  }
  document.addEventListener('astro:page-load', init);</script>
