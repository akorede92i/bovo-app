---
import Layout from '@layouts/Layout.astro';
import ServiceCard from '@components/ServiceCard.astro';
import Icon from '@components/Icon.astro';
import { fcfa, MENAGE_HOURLY_XOF, MENAGE_MIN_HOURS, AIRBNB_TURNOVERS, DEM_VOLUMES, CHEF_FREQUENCES, PLOMBIER_TYPES } from '@lib/catalog';

const menagePriceFrom = MENAGE_HOURLY_XOF * MENAGE_MIN_HOURS;
const airbnbPriceFrom = AIRBNB_TURNOVERS[0].priceXof;
const demPriceFrom = DEM_VOLUMES[0].priceXof;
const chefPriceFrom = CHEF_FREQUENCES[0].baseXof;
const plombierPriceFrom = Math.min(...PLOMBIER_TYPES.map((t) => t.priceXof));
---
<Layout
  title="Bovo — Réservez votre prestation à Cotonou en 2 minutes"
  description="Ménage, plomberie, déménagement, chef à domicile et service Airbnb à Cotonou, Calavi, Porto-Novo. Réservez en ligne, prestataires vérifiés, paiement Mobile Money."
  shell="landing"
>
  <!-- ============ HERO ============ -->
  <section class="home-hero">
    <div class="l-container home-hero-inner">
      <div class="home-hero-content">
        <span class="home-hero-tag">● Cotonou • Calavi • Porto-Novo</span>
        <h1 class="home-hero-title">Votre prestation,<br><span class="accent">réservée en 2 min.</span></h1>
        <p class="home-hero-sub">Votre maison propre, votre repas prêt.</p>
        <p class="home-hero-desc">
          Ménage, plomberie, déménagement, chef à domicile et turnover Airbnb. Prestataires Bovo vérifiés,
          tarifs clairs, intervention 7j/7.
        </p>
        <div class="home-hero-actions">
          <a href="#services" class="btn btn-primary btn-lg">Voir nos services</a>
          <a href="https://wa.me/2290196677743" target="_blank" rel="noopener" class="btn btn-ghost btn-lg">
            <Icon name="whatsapp" size={18} /> Nous joindre
          </a>
        </div>
        <div class="home-trust-row">
          <span class="trust-pill"><Icon name="shield" size={16} /> Équipes vérifiées</span>
          <span class="trust-pill" id="trust-rating"><Icon name="star" size={16} /> <span data-rating-text>4,8/5 satisfaction</span></span>
          <span class="trust-pill"><Icon name="clock" size={16} /> Intervention sous 24h</span>
          <span class="trust-pill"><Icon name="phone" size={16} /> Support WhatsApp 7j/7</span>
        </div>
      </div>
      <aside class="home-hero-visual" aria-hidden="true">
        <div class="home-hero-card home-hero-card-1">
          <div class="home-hero-card-icon"><Icon name="broom" size={20} /></div>
          <div>
            <div class="home-hero-card-title">Ménage demain matin</div>
            <div class="home-hero-card-meta">10 000 FCFA · 3h · Équipe Bovo</div>
          </div>
          <div class="home-hero-card-badge">✓ Confirmé</div>
        </div>
        <div class="home-hero-card home-hero-card-2">
          <div class="home-hero-card-icon" style="background: rgba(162,28,38,0.10); color: var(--bovo-rouge);"><Icon name="airbnb" size={20} /></div>
          <div>
            <div class="home-hero-card-title">Turnover Airbnb auto</div>
            <div class="home-hero-card-meta">8 000 FCFA · à chaque check-out</div>
          </div>
          <div class="home-hero-card-badge">⚡ Auto iCal</div>
        </div>
        <div class="home-hero-card home-hero-card-3">
          <div class="home-hero-card-icon"><Icon name="truck" size={20} /></div>
          <div>
            <div class="home-hero-card-title">Déménagement samedi</div>
            <div class="home-hero-card-meta">45 000 FCFA · Camion + 2 manutent.</div>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <!-- ============ SERVICES ============ -->
  <section class="home-section" id="services">
    <div class="l-container">
      <div class="home-section-head">
        <h2 class="home-section-title">Que peut-on faire pour vous&nbsp;?</h2>
        <p class="home-section-sub">5 services pour faire tourner votre maison et votre activité, sans stress.</p>
      </div>
      <div class="home-services">
        <ServiceCard
          href="/menage/"
          icon="broom"
          iconColor="bleu"
          title="Ménage à domicile"
          meta={`Dès <strong>${fcfa(menagePriceFrom)}</strong> · à partir de 2h`}
        />
        <ServiceCard
          href="/airbnb/"
          icon="airbnb"
          iconColor="rouge"
          title="Service Airbnb (hosts)"
          meta={`Dès <strong>${fcfa(airbnbPriceFrom)}</strong>/turnover · auto avec votre iCal`}
          badge="Pro"
        />
        <ServiceCard
          href="/demenagement/"
          icon="truck"
          iconColor="bleu"
          title="Déménagement"
          meta={`Dès <strong>${fcfa(demPriceFrom)}</strong> · cartons inclus`}
        />
        <ServiceCard
          href="/chef/"
          icon="chef"
          iconColor="rouge"
          title="Chef à domicile"
          meta={`Dès <strong>${fcfa(chefPriceFrom)}</strong>/mois · engagement 1 mois min`}
        />
        <ServiceCard
          href="/plombier/"
          icon="wrench"
          iconColor="bleu"
          title="Plombier à domicile"
          meta={`Dès <strong>${fcfa(plombierPriceFrom)}</strong> · urgence et réparation 7j/7`}
        />
      </div>
    </div>
  </section>

  <!-- ============ COMMENT ÇA MARCHE ============ -->
  <section class="home-section home-section-alt" id="fonctionnement">
    <div class="l-container">
      <div class="home-section-head">
        <h2 class="home-section-title">Comment ça marche</h2>
        <p class="home-section-sub">3 étapes pour passer de l'envie à l'équipe Bovo chez vous.</p>
      </div>
      <div class="grid-3 home-steps">
        <div class="home-step">
          <div class="home-step-num">1</div>
          <div class="home-step-title">Choisissez votre service</div>
          <div class="home-step-desc">Ménage, Airbnb, déménagement, chef ou plombier. Tarif affiché en direct, sans surprise.</div>
        </div>
        <div class="home-step">
          <div class="home-step-num">2</div>
          <div class="home-step-title">Adresse, date, options</div>
          <div class="home-step-desc">2 minutes max. Pas besoin de compte pour réserver, pin GPS pour qu'on trouve facilement.</div>
        </div>
        <div class="home-step">
          <div class="home-step-num">3</div>
          <div class="home-step-title">Confirmation WhatsApp</div>
          <div class="home-step-desc">Notre équipe vous confirme en moins d'1h. Paiement sur place, Mobile Money ou virement.</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ COMPTE + SUPPORT (2 col desktop) ============ -->
  <section class="home-section">
    <div class="l-container">
      <div class="grid-2 home-bottom">
        <div class="home-bottom-card home-bottom-card-account">
          <div class="home-bottom-icon" style="background: var(--bovo-bleu); color: #fff;">
            <Icon name="user" size={22} />
          </div>
          <div style="flex:1; min-width:0;">
            <div class="home-bottom-title">Créez votre compte Bovo</div>
            <div class="home-bottom-desc">Sauvegardez votre adresse, suivez vos réservations, réservez en 1 clic la prochaine fois.</div>
            <div class="flex gap-sm" style="margin-top:14px; flex-wrap:wrap;">
              <a href="/compte/inscription/" class="btn btn-primary btn-sm">Créer un compte</a>
              <a href="/compte/connexion/" class="btn btn-ghost btn-sm">Se connecter</a>
            </div>
          </div>
        </div>
        <a href="https://wa.me/2290196677743" target="_blank" rel="noopener" class="home-bottom-card home-bottom-card-support">
          <div class="home-bottom-icon" style="background: rgba(37,211,102,0.12); color: var(--bovo-whatsapp);">
            <Icon name="whatsapp" size={22} />
          </div>
          <div style="flex:1; min-width:0;">
            <div class="home-bottom-title">Une question ?</div>
            <div class="home-bottom-desc">Notre équipe répond sur WhatsApp en moins de 30 min, 7j/7.</div>
            <div style="margin-top:14px;">
              <span class="btn btn-primary btn-sm" style="background: var(--bovo-whatsapp); box-shadow: 0 6px 18px rgba(37,211,102,0.28);">Démarrer une conversation</span>
            </div>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- ============ FOOTER ============ -->
  <footer class="home-footer">
    <div class="l-container home-footer-inner">
      <div>
        <a href="/" class="bovo-logo" style="font-size:1.6rem;">B<span class="o-rouge">O</span>VO</a>
        <p class="home-footer-text">
          Vobodou Groupe SARL<br>
          RCCM RB/COT/24B/37037 · IFU 3202451098452<br>
          Haie Vive, Cotonou, Bénin
        </p>
      </div>
      <div class="home-footer-col">
        <div class="home-footer-h">Services</div>
        <a href="/menage/">Ménage à domicile</a>
        <a href="/airbnb/">Service Airbnb</a>
        <a href="/demenagement/">Déménagement</a>
        <a href="/chef/">Chef à domicile</a>
        <a href="/plombier/">Plombier à domicile</a>
      </div>
      <div class="home-footer-col">
        <div class="home-footer-h">Compte</div>
        <a href="/compte/inscription/">Créer un compte</a>
        <a href="/compte/connexion/">Se connecter</a>
        <a href="https://wa.me/2290196677743" target="_blank" rel="noopener">Support WhatsApp</a>
      </div>
      <div class="home-footer-col">
        <div class="home-footer-h">Légal</div>
        <a href="https://bovo.bj/mentions-legales.html">Mentions légales</a>
        <a href="https://bovo.bj/confidentialite.html">Confidentialité</a>
        <a href="https://bovo.bj">bovo.bj</a>
      </div>
    </div>
    <div class="home-footer-bottom">
      <div class="l-container">© 2026 Vobodou Groupe SARL — Tous droits réservés</div>
    </div>
  </footer>
</Layout>

<script>
  // Note moyenne globale chargée dynamiquement depuis Supabase.
  // Si la fonction n'est pas dispo (Supabase non configuré ou aucun avis), on garde le fallback statique.
  import { getSupabase } from '@lib/supabase';

  const supa = getSupabase();
  if (supa) {
    const { data, error } = await supa.rpc('global_review_stats');
    if (!error && Array.isArray(data) && data.length > 0) {
      const row = data[0] as { review_count: number; avg_rating: number };
      const count = Number(row.review_count ?? 0);
      const avg = Number(row.avg_rating ?? 0);
      if (count > 0 && avg > 0) {
        const target = document.querySelector('#trust-rating [data-rating-text]');
        if (target) {
          const formatted = avg.toFixed(1).replace('.', ',');
          target.textContent = `${formatted}/5 · ${count} avis`;
        }
      }
    }
  }
</script>

<style>
  /* ============ HERO ============ */
  .home-hero {
    background: linear-gradient(160deg, #e8f0fc 0%, #fff 55%, #fde8ea 130%);
    padding: 40px 0 56px;
    position: relative;
    overflow: hidden;
  }
  .home-hero::before, .home-hero::after {
    content: '';
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }
  .home-hero::before {
    width: 480px; height: 480px;
    background: radial-gradient(circle, rgba(68,112,179,0.10) 0%, transparent 65%);
    top: -120px; left: -80px;
  }
  .home-hero::after {
    width: 400px; height: 400px;
    background: radial-gradient(circle, rgba(162,28,38,0.07) 0%, transparent 65%);
    bottom: -100px; right: -60px;
  }
  .home-hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    align-items: center;
  }
  .home-hero-content { position: relative; z-index: 1; }
  .home-hero-tag {
    display: inline-block;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--bovo-bleu);
    background: rgba(68,112,179,0.10);
    padding: 6px 12px;
    border-radius: var(--r-full);
    margin-bottom: 18px;
  }
  .home-hero-title {
    font-family: 'Jost', sans-serif;
    font-weight: 800;
    font-size: 2rem;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--bovo-ink);
    margin-bottom: 12px;
  }
  .home-hero-title .accent { color: var(--bovo-bleu); }
  .home-hero-sub {
    font-family: 'Jost', sans-serif;
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--bovo-rouge);
    margin-bottom: 12px;
  }
  .home-hero-desc {
    font-size: 1rem;
    color: var(--bovo-ink-soft);
    line-height: 1.6;
    margin-bottom: 22px;
    max-width: 540px;
  }
  .home-hero-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 28px;
  }
  .home-hero-actions .btn { padding: 0 22px; height: 50px; font-size: 0.95rem; }
  .home-trust-row {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  /* Visual cards stack (desktop only) */
  .home-hero-visual {
    display: none;
    position: relative;
    height: 460px;
  }
  .home-hero-card {
    position: absolute;
    background: #fff;
    border-radius: var(--r-lg);
    padding: 14px 16px;
    display: flex;
    align-items: center;
    gap: 12px;
    box-shadow: 0 8px 28px rgba(0,0,0,0.10), 0 0 0 1px rgba(68,112,179,0.06);
    width: 320px;
    transition: transform 0.3s var(--ease);
  }
  .home-hero-card:hover { transform: translateY(-4px); }
  .home-hero-card-icon {
    flex-shrink: 0;
    width: 40px; height: 40px;
    border-radius: var(--r-md);
    background: var(--bovo-bleu-light);
    color: var(--bovo-bleu);
    display: flex; align-items: center; justify-content: center;
  }
  .home-hero-card-title { font-weight: 600; font-size: 0.92rem; margin-bottom: 2px; }
  .home-hero-card-meta { font-size: 0.78rem; color: var(--bovo-muted); }
  .home-hero-card-badge {
    font-size: 0.7rem; font-weight: 700;
    background: rgba(34,197,94,0.10);
    color: #16a34a;
    padding: 4px 8px;
    border-radius: var(--r-full);
    white-space: nowrap;
  }
  .home-hero-card-1 { top: 20px;  right: 0;   transform: rotate(-2deg); }
  .home-hero-card-2 { top: 170px; right: 40px; transform: rotate(2deg); }
  .home-hero-card-2 .home-hero-card-badge { background: rgba(68,112,179,0.10); color: var(--bovo-bleu); }
  .home-hero-card-3 { top: 320px; right: 10px; transform: rotate(-1deg); }

  /* ============ SERVICES GRID (5 cards) ============ */
  .home-services {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }
  @media (min-width: 640px) {
    .home-services { grid-template-columns: repeat(2, 1fr); gap: 20px; }
  }
  @media (min-width: 1024px) {
    /* 5 cards → 3+2 sur ligne 1+2, mieux équilibré que 4+1 */
    .home-services { grid-template-columns: repeat(3, 1fr); gap: 24px; }
  }
  @media (min-width: 1280px) {
    /* Sur très grand écran, 5 cards alignées sur une seule ligne */
    .home-services { grid-template-columns: repeat(5, 1fr); gap: 18px; }
  }

  /* ============ SECTIONS ============ */
  .home-section { padding: 56px 0; }
  .home-section-alt { background: var(--bovo-bg-soft); }
  .home-section-head { text-align: center; margin-bottom: 32px; }
  .home-section-title {
    font-family: 'Jost', sans-serif;
    font-weight: 800;
    font-size: 1.8rem;
    letter-spacing: -0.01em;
    color: var(--bovo-ink);
    margin-bottom: 8px;
  }
  .home-section-sub {
    font-size: 1rem;
    color: var(--bovo-muted);
    max-width: 560px;
    margin: 0 auto;
  }

  /* ============ COMMENT ÇA MARCHE ============ */
  .home-step {
    background: #fff;
    border-radius: var(--r-lg);
    padding: 28px 24px;
    border: 1px solid var(--bovo-line-soft);
    transition: all var(--t-base) var(--ease);
  }
  .home-step:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(0,0,0,0.06);
  }
  .home-step-num {
    width: 44px; height: 44px;
    border-radius: 50%;
    background: var(--bovo-bleu);
    color: #fff;
    display: flex; align-items: center; justify-content: center;
    font-family: 'Jost', sans-serif;
    font-weight: 800;
    font-size: 1.2rem;
    margin-bottom: 16px;
    box-shadow: 0 6px 16px rgba(68, 112, 179, 0.25);
  }
  .home-step-title {
    font-family: 'Jost', sans-serif;
    font-weight: 700;
    font-size: 1.05rem;
    margin-bottom: 8px;
    color: var(--bovo-ink);
  }
  .home-step-desc {
    font-size: 0.94rem;
    color: var(--bovo-ink-soft);
    line-height: 1.55;
  }

  /* ============ COMPTE + SUPPORT ============ */
  .home-bottom-card {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: 28px 24px;
    background: #fff;
    border-radius: var(--r-lg);
    border: 1px solid var(--bovo-line-soft);
    text-decoration: none;
    color: inherit;
    transition: all var(--t-base) var(--ease);
  }
  .home-bottom-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(0,0,0,0.08);
  }
  .home-bottom-card-account {
    background: linear-gradient(135deg, var(--bovo-bleu-light) 0%, #fff 100%);
    border-color: transparent;
  }
  .home-bottom-icon {
    flex-shrink: 0;
    width: 48px; height: 48px;
    border-radius: var(--r-md);
    display: flex; align-items: center; justify-content: center;
  }
  .home-bottom-title {
    font-family: 'Jost', sans-serif;
    font-weight: 700;
    font-size: 1.1rem;
    margin-bottom: 4px;
  }
  .home-bottom-desc {
    color: var(--bovo-ink-soft);
    font-size: 0.94rem;
    line-height: 1.55;
  }

  /* ============ FOOTER ============ */
  .home-footer {
    background: var(--bovo-ink);
    color: rgba(255,255,255,0.7);
    padding: 48px 0 0;
    margin-top: 32px;
  }
  .home-footer-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    padding-bottom: 32px;
  }
  .home-footer-text {
    font-size: 0.84rem;
    line-height: 1.6;
    margin-top: 12px;
  }
  .home-footer-col { display: flex; flex-direction: column; gap: 8px; }
  .home-footer-h {
    color: #fff;
    font-family: 'Jost', sans-serif;
    font-weight: 700;
    font-size: 0.92rem;
    margin-bottom: 8px;
  }
  .home-footer-col a {
    color: rgba(255,255,255,0.7);
    font-size: 0.88rem;
    transition: color var(--t-fast) var(--ease);
  }
  .home-footer-col a:hover { color: #fff; }
  .home-footer-bottom {
    background: rgba(0,0,0,0.2);
    padding: 14px 0;
    font-size: 0.78rem;
    color: rgba(255,255,255,0.5);
    text-align: center;
  }

  /* ============ RESPONSIVE ============ */
  @media (min-width: 768px) {
    .home-hero { padding: 56px 0 72px; }
    .home-hero-title { font-size: 2.6rem; }
    .home-hero-sub { font-size: 1.2rem; }
    .home-section { padding: 72px 0; }
    .home-section-title { font-size: 2.2rem; }
    .home-footer-inner { grid-template-columns: 1.5fr 1fr 1fr 1fr; gap: 48px; padding-bottom: 40px; }
  }
  @media (min-width: 1024px) {
    .home-hero-inner {
      grid-template-columns: 1.1fr 1fr;
      gap: 48px;
    }
    .home-hero-visual { display: block; }
    .home-hero { padding: 80px 0 96px; }
    .home-hero-title { font-size: 3rem; }
  }
</style>
