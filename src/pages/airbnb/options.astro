---
import Layout from '@layouts/Layout.astro';
import Stepper from '@components/Stepper.astro';
import CtaFooter from '@components/CtaFooter.astro';
import Icon from '@components/Icon.astro';
import { AIRBNB_OPTIONS, fcfa } from '@lib/catalog';
---
<Layout
  title="Airbnb — Étape 4 : Options | Bovo"
  topbar="back"
  backHref="/airbnb/mode/"
  pageTitle="Service Airbnb"
  noindex
>
  <Fragment slot="topbar-extra"><Stepper total={7} current={4} /></Fragment>

  <h1 class="h-display" style="margin-bottom:8px;">Vos options par turnover</h1>
  <p class="text-lead" style="margin-bottom:24px;">Sélectionnez ce que Bovo doit gérer entre chaque voyageur.</p>

  <div class="stack-sm" id="opt-list">
    {AIRBNB_OPTIONS.map((o) => (
      <button class="opt" data-value={o.id} data-price={o.priceXof}>
        <span class="opt-check"><Icon name="check" size={14} /></span>
        <span class="opt-body">
          <span class="opt-title">{o.label}</span>
          <span class="opt-meta">{o.meta}</span>
        </span>
        <span class="opt-price">+{fcfa(o.priceXof)}</span>
      </button>
    ))}
  </div>

  <CtaFooter buttonLabel="Continuer" buttonType="button" buttonId="cta-next" priceLabel="Total par turnover" priceValue="—" />
</Layout>

<script>
  import { loadState, saveState, type AirbnbState } from '@lib/state';
  import { AIRBNB_OPTIONS, fcfa } from '@lib/catalog';

  const list = document.getElementById('opt-list')!;
  const cta = document.getElementById('cta-next') as HTMLButtonElement;
  const priceEl = document.querySelector('.cta-footer .price-line strong')!;

  const s = loadState<AirbnbState>('airbnb');
  let options = new Set<string>(s.options ?? []);
  const base = s.estimatedPerTurnover ?? 0;

  function compute() {
    const opts = [...options].reduce((sum, id) => {
      const o = AIRBNB_OPTIONS.find((x) => x.id === id);
      return sum + (o?.priceXof ?? 0);
    }, 0);
    return base + opts;
  }

  function render() {
    list.querySelectorAll<HTMLButtonElement>('.opt').forEach((el) => {
      el.classList.toggle('is-active', options.has(el.dataset.value!));
    });
    priceEl.textContent = fcfa(compute());
  }

  list.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.opt');
    if (!btn) return;
    const v = btn.dataset.value!;
    if (options.has(v)) options.delete(v); else options.add(v);
    saveState<AirbnbState>('airbnb', { options: [...options], estimatedPerTurnover: compute() });
    render();
  });

  cta.addEventListener('click', () => {
    saveState<AirbnbState>('airbnb', { options: [...options], estimatedPerTurnover: compute() });
    window.location.href = '/airbnb/adresse/';
  });

  render();
</script>
