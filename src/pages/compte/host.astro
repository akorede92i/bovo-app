---
import Layout from '@layouts/Layout.astro';
import Icon from '@components/Icon.astro';
import CompteSidebar from '@components/CompteSidebar.astro';
import { ZONES, AIRBNB_TURNOVERS } from '@lib/catalog';
---
<Layout
  title="Mes logements Airbnb — Bovo"
  pageTitle="Mes logements Airbnb"
  shell="dashboard"
  noindex
>
  <Fragment slot="sidebar"><CompteSidebar active="host" /></Fragment>

  <div id="loading" style="text-align:center; padding:48px 20px;">
    <div class="text-muted">Chargement…</div>
  </div>

  <div id="content" hidden>
    <p class="text-lead" style="margin-bottom:20px;">
      Gérez vos logements Airbnb et leurs calendriers iCal pour automatiser les turnovers.
    </p>

    <div id="property-list" class="stack-md" style="margin-bottom:24px;"></div>

    <div id="empty" hidden class="card card-elevated" style="text-align:center; padding:32px 20px;">
      <div style="color: var(--bovo-muted); margin-bottom:12px;">
        <Icon name="airbnb" size={40} />
      </div>
      <div style="font-family:'Jost'; font-weight:700; margin-bottom:6px;">Aucun logement enregistré</div>
      <div class="text-muted">Ajoutez votre premier logement pour démarrer le service Airbnb.</div>
    </div>

    <button id="add-btn" class="btn btn-primary btn-block">
      <Icon name="plus" size={20} /> Ajouter un logement
    </button>
  </div>

  <!-- MODAL : ajout / édition -->
  <div id="modal" hidden role="dialog" aria-modal="true" aria-labelledby="modal-title" style="position:fixed; inset:0; z-index: var(--z-modal); background: rgba(17,24,39,0.5); display:flex; align-items:flex-end; justify-content:center;">
    <div style="background:#fff; width:100%; max-width: var(--app-max); border-radius: var(--r-xl) var(--r-xl) 0 0; padding: 20px 20px calc(20px + var(--safe-bottom)); max-height: 90vh; overflow-y:auto;">
      <div class="flex-between" style="margin-bottom:16px;">
        <h2 id="modal-title" class="h-title">Ajouter un logement</h2>
        <button id="modal-close" class="topbar-back" aria-label="Fermer"><Icon name="close" size={20} /></button>
      </div>

      <form id="prop-form" novalidate>
        <input type="hidden" id="prop-id" />

        <div class="field">
          <label class="field-label" for="prop-label">Nom du logement</label>
          <input id="prop-label" class="input" type="text" placeholder="ex. Studio Cadjèhoun, Villa Bord de mer" required />
        </div>

        <div class="field">
          <label class="field-label" for="prop-size">Taille</label>
          <select id="prop-size" class="select" required>
            <option value="">Choisir…</option>
            {AIRBNB_TURNOVERS.map((t) => <option value={t.id}>{t.label} — {t.meta}</option>)}
          </select>
        </div>

        <div class="field">
          <label class="field-label" for="prop-zone">Zone</label>
          <select id="prop-zone" class="select" required>
            <option value="">Choisir une zone…</option>
            {ZONES.map((z) => <option value={z}>{z}</option>)}
          </select>
        </div>

        <div class="field">
          <label class="field-label" for="prop-quartier">Quartier</label>
          <input id="prop-quartier" class="input" type="text" placeholder="ex. Cadjèhoun, Haie Vive…" />
        </div>

        <div class="field">
          <label class="field-label" for="prop-street">Adresse</label>
          <input id="prop-street" class="input" type="text" placeholder="Rue, numéro, repères" required />
        </div>

        <div class="field">
          <label class="field-label" for="prop-ical">URL iCal Airbnb (optionnel)</label>
          <input id="prop-ical" class="input" type="url" placeholder="https://www.airbnb.com/calendar/ical/..." />
          <span class="field-hint">Annonce Airbnb → Calendrier → Disponibilités → Exporter le calendrier.</span>
        </div>

        <div class="field">
          <label class="field-label" for="prop-access">Instructions d'accès</label>
          <textarea id="prop-access" class="textarea" placeholder="ex. Boîte à clés code 1234 sous la jardinière à droite de la porte."></textarea>
        </div>

        <div id="prop-error" class="text-muted" style="color: var(--bovo-danger); display:none; margin:8px 0;"></div>

        <div class="flex gap-md" style="margin-top: 18px;">
          <button type="button" id="prop-delete" class="btn btn-ghost" style="flex:1; display:none;">Supprimer</button>
          <button type="submit" class="btn btn-primary" style="flex:2;">Enregistrer</button>
        </div>
      </form>
    </div>
  </div>
</Layout>

<script>
  import { requireAuth } from '@lib/auth';
  import { getSupabase } from '@lib/supabase';
  import { AIRBNB_TURNOVERS, fcfa } from '@lib/catalog';

  const user = await requireAuth();
  const supa = getSupabase();
  if (!supa) {
    document.getElementById('loading')!.textContent = 'Service indisponible.';
  } else {
    const listEl = document.getElementById('property-list')!;
    const empty = document.getElementById('empty')!;
    const modal = document.getElementById('modal')!;
    const modalTitle = document.getElementById('modal-title')!;
    const form = document.getElementById('prop-form') as HTMLFormElement;
    const idEl = document.getElementById('prop-id') as HTMLInputElement;
    const labelEl = document.getElementById('prop-label') as HTMLInputElement;
    const sizeEl = document.getElementById('prop-size') as HTMLSelectElement;
    const zoneEl = document.getElementById('prop-zone') as HTMLSelectElement;
    const quartierEl = document.getElementById('prop-quartier') as HTMLInputElement;
    const streetEl = document.getElementById('prop-street') as HTMLInputElement;
    const icalEl = document.getElementById('prop-ical') as HTMLInputElement;
    const accessEl = document.getElementById('prop-access') as HTMLTextAreaElement;
    const errEl = document.getElementById('prop-error') as HTMLDivElement;
    const deleteBtn = document.getElementById('prop-delete') as HTMLButtonElement;

    function openModal(p?: any) {
      errEl.style.display = 'none';
      if (p) {
        modalTitle.textContent = 'Modifier le logement';
        idEl.value = p.id;
        labelEl.value = p.label;
        sizeEl.value = p.size_type;
        zoneEl.value = p.zone;
        quartierEl.value = p.quartier ?? '';
        streetEl.value = p.street;
        icalEl.value = p.ical_url ?? '';
        accessEl.value = p.access_instructions ?? '';
        deleteBtn.style.display = '';
      } else {
        modalTitle.textContent = 'Ajouter un logement';
        form.reset();
        idEl.value = '';
        deleteBtn.style.display = 'none';
      }
      modal.hidden = false;
    }
    function closeModal() { modal.hidden = true; }

    async function load() {
      const { data, error } = await supa.from('airbnb_properties').select('*').eq('owner_user_id', user.id).order('created_at', { ascending: false });
      if (error) {
        listEl.innerHTML = `<div class="text-muted" style="color: var(--bovo-danger);">Erreur : ${error.message}</div>`;
        return;
      }
      const properties = data ?? [];
      listEl.innerHTML = '';
      if (properties.length === 0) {
        empty.hidden = false;
        return;
      }
      empty.hidden = true;
      for (const p of properties) {
        const size = AIRBNB_TURNOVERS.find((t) => t.id === p.size_type);
        const card = document.createElement('button');
        card.className = 'card card-elevated card-tap';
        card.style.cssText = 'text-align:left; width:100%; display:block;';
        card.innerHTML = `
          <div class="flex-between" style="margin-bottom:8px;">
            <div style="font-family:'Jost'; font-weight:700; font-size:1.05rem;">${p.label}</div>
            ${p.ical_url ? '<span style="font-size:0.62rem; background: var(--bovo-success); color:#fff; padding:2px 8px; border-radius: var(--r-full); letter-spacing:1px; text-transform:uppercase;">iCal connecté</span>' : '<span style="font-size:0.62rem; background: var(--bovo-warning); color:#fff; padding:2px 8px; border-radius: var(--r-full); letter-spacing:1px; text-transform:uppercase;">Sans iCal</span>'}
          </div>
          <div class="text-muted" style="font-size:0.86rem; line-height:1.5;">
            ${size?.label ?? '—'} · ${p.zone}<br>
            ${p.street}${p.quartier ? `, ${p.quartier}` : ''}
          </div>
          <div style="margin-top:10px; padding-top:10px; border-top: 1px solid var(--bovo-line-soft); font-family:'Jost'; font-weight:700; color: var(--bovo-bleu); font-size:0.92rem;">
            ${fcfa(size?.priceXof ?? 0)} / turnover
          </div>
        `;
        card.addEventListener('click', () => openModal(p));
        listEl.appendChild(card);
      }
    }

    document.getElementById('add-btn')!.addEventListener('click', () => openModal());
    document.getElementById('modal-close')!.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errEl.style.display = 'none';
      const id = idEl.value || undefined;
      const payload = {
        owner_user_id: user.id,
        label: labelEl.value.trim(),
        size_type: sizeEl.value,
        zone: zoneEl.value,
        quartier: quartierEl.value.trim() || null,
        street: streetEl.value.trim(),
        ical_url: icalEl.value.trim() || null,
        access_instructions: accessEl.value.trim() || null,
      };
      const op = id
        ? supa.from('airbnb_properties').update(payload).eq('id', id)
        : supa.from('airbnb_properties').insert(payload);
      const { error } = await op;
      if (error) {
        errEl.textContent = error.message;
        errEl.style.display = 'block';
        return;
      }
      closeModal();
      await load();
    });

    deleteBtn.addEventListener('click', async () => {
      const id = idEl.value;
      if (!id) return;
      if (!confirm('Supprimer ce logement et tous ses turnovers liés ?')) return;
      const { error } = await supa.from('airbnb_properties').delete().eq('id', id);
      if (error) {
        errEl.textContent = error.message;
        errEl.style.display = 'block';
        return;
      }
      closeModal();
      await load();
    });

    await load();
    document.getElementById('loading')!.hidden = true;
    document.getElementById('content')!.hidden = false;
  }
</script>
