---
import Layout from '@layouts/Layout.astro';
import Icon from '@components/Icon.astro';
import CompteSidebar from '@components/CompteSidebar.astro';
---
<Layout
  title="Mon compte — Bovo"
  pageTitle="Tableau de bord"
  shell="dashboard"
  noindex
>
  <Fragment slot="sidebar"><CompteSidebar active="home" /></Fragment>

  <!-- Loading state -->
  <div id="loading" style="text-align:center; padding:48px 20px;">
    <div class="text-muted">Chargement…</div>
  </div>

  <!-- Content -->
  <div id="content" hidden>
    <!-- Greeting -->
    <div class="dash-greeting">
      <div>
        <div class="dash-greeting-tag">● Tableau de bord</div>
        <h1 class="dash-greeting-title" id="hello">Bonjour 👋</h1>
        <p class="dash-greeting-sub" id="user-email">—</p>
      </div>
      <a href="/" class="btn btn-primary btn-sm dash-greeting-cta">
        <Icon name="sparkles" size={16} /> Nouvelle réservation
      </a>
    </div>

    <!-- Stats -->
    <div class="grid-2 dash-stats">
      <div class="dash-stat">
        <div class="dash-stat-label">Réservations</div>
        <div class="dash-stat-value" id="stat-reservations">0</div>
        <div class="dash-stat-meta">Total depuis votre inscription</div>
      </div>
      <div class="dash-stat">
        <div class="dash-stat-label">Adresses sauvées</div>
        <div class="dash-stat-value" style="color: var(--bovo-rouge);" id="stat-addresses">0</div>
        <div class="dash-stat-meta">Pour réserver en 1 clic</div>
      </div>
    </div>

    <!-- Prochaine résa -->
    <div id="next-reservation" hidden>
      <h2 class="h-section" style="margin: 28px 0 12px;">Votre prochaine prestation</h2>
      <div class="card card-elevated" id="next-card"></div>
    </div>

    <!-- Suggestions / quick CTAs -->
    <h2 class="h-section" style="margin: 28px 0 12px;">Nos services</h2>
    <div class="grid-2 dash-services">
      <a href="/menage/" class="dash-service-card">
        <div class="dash-service-icon"><Icon name="broom" size={22} /></div>
        <div>
          <div class="dash-service-title">Ménage</div>
          <div class="dash-service-meta">Dès 7 000 FCFA</div>
        </div>
      </a>
      <a href="/airbnb/" class="dash-service-card">
        <div class="dash-service-icon" style="background: rgba(162,28,38,0.10); color: var(--bovo-rouge);"><Icon name="airbnb" size={22} /></div>
        <div>
          <div class="dash-service-title">Service Airbnb</div>
          <div class="dash-service-meta">Dès 8 000 FCFA / turnover</div>
        </div>
      </a>
      <a href="/demenagement/" class="dash-service-card">
        <div class="dash-service-icon"><Icon name="truck" size={22} /></div>
        <div>
          <div class="dash-service-title">Déménagement</div>
          <div class="dash-service-meta">Cartons inclus</div>
        </div>
      </a>
      <a href="/chef/" class="dash-service-card">
        <div class="dash-service-icon" style="background: rgba(162,28,38,0.10); color: var(--bovo-rouge);"><Icon name="chef" size={22} /></div>
        <div>
          <div class="dash-service-title">Chef à domicile</div>
          <div class="dash-service-meta">Engagement 1 mois min.</div>
        </div>
      </a>
    </div>
  </div>
</Layout>

<style>
  .dash-greeting {
    background: linear-gradient(135deg, var(--bovo-bleu-light) 0%, #fff 100%);
    border-radius: var(--r-lg);
    padding: 24px;
    margin-bottom: 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .dash-greeting-tag {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--bovo-bleu);
    margin-bottom: 6px;
  }
  .dash-greeting-title {
    font-family: 'Jost', sans-serif;
    font-weight: 800;
    font-size: 1.5rem;
    color: var(--bovo-ink);
    margin-bottom: 4px;
    line-height: 1.2;
  }
  .dash-greeting-sub { color: var(--bovo-muted); font-size: 0.9rem; }
  .dash-greeting-cta { flex-shrink: 0; }

  .dash-stat {
    background: #fff;
    border-radius: var(--r-lg);
    border: 1px solid var(--bovo-line-soft);
    padding: 20px;
  }
  .dash-stat-label {
    font-size: 0.74rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    color: var(--bovo-muted);
    margin-bottom: 6px;
  }
  .dash-stat-value {
    font-family: 'Jost', sans-serif;
    font-weight: 800;
    font-size: 2rem;
    color: var(--bovo-bleu);
    line-height: 1;
    margin-bottom: 8px;
  }
  .dash-stat-meta { font-size: 0.82rem; color: var(--bovo-muted); }

  .dash-service-card {
    background: #fff;
    border: 1px solid var(--bovo-line-soft);
    border-radius: var(--r-lg);
    padding: 16px;
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: inherit;
    transition: all var(--t-fast) var(--ease);
  }
  .dash-service-card:hover {
    transform: translateY(-2px);
    border-color: var(--bovo-bleu);
    box-shadow: 0 8px 24px rgba(68,112,179,0.08);
  }
  .dash-service-icon {
    width: 42px; height: 42px;
    border-radius: var(--r-md);
    background: var(--bovo-bleu-light);
    color: var(--bovo-bleu);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .dash-service-title { font-weight: 600; font-size: 0.95rem; margin-bottom: 2px; }
  .dash-service-meta { font-size: 0.82rem; color: var(--bovo-muted); }

  @media (max-width: 640px) {
    .dash-greeting-cta { width: 100%; }
  }
</style>

<script>
  import { requireAuth } from '@lib/auth';
  import { getSupabase } from '@lib/supabase';
  import { fcfa } from '@lib/catalog';

  const user = await requireAuth();
  const supa = getSupabase();
  if (!supa) {
    document.getElementById('loading')!.textContent = 'Service indisponible.';
  } else {
    const name = user.profile?.full_name ?? user.email.split('@')[0];
    document.getElementById('hello')!.textContent = `Bonjour ${name.split(' ')[0]} 👋`;
    document.getElementById('user-email')!.textContent = user.email;

    const [resCountRes, addrCountRes, nextRes] = await Promise.all([
      supa.from('reservations').select('id', { count: 'exact', head: true }).eq('user_id', user.id),
      supa.from('addresses').select('id', { count: 'exact', head: true }).eq('user_id', user.id),
      supa.from('reservations')
        .select('id, service_type, status, scheduled_at, estimated_total_xof, payload')
        .eq('user_id', user.id)
        .gte('scheduled_at', new Date().toISOString())
        .in('status', ['pending', 'confirmed', 'assigned'])
        .order('scheduled_at', { ascending: true })
        .limit(1)
        .maybeSingle(),
    ]);

    document.getElementById('stat-reservations')!.textContent = String(resCountRes.count ?? 0);
    document.getElementById('stat-addresses')!.textContent = String(addrCountRes.count ?? 0);

    if (nextRes.data) {
      const r = nextRes.data as any;
      const block = document.getElementById('next-reservation')!;
      block.hidden = false;
      const labels: Record<string, string> = {
        menage: 'Ménage à domicile',
        airbnb: 'Service Airbnb',
        demenagement: 'Déménagement',
        chef: 'Chef à domicile',
        plombier: 'Plombier',
      };
      const statusLabels: Record<string, string> = {
        pending: 'En attente',
        confirmed: 'Confirmée',
        assigned: 'Équipe assignée',
      };
      const statusColors: Record<string, string> = {
        pending: 'var(--bovo-warning)',
        confirmed: 'var(--bovo-success)',
        assigned: 'var(--bovo-success)',
      };
      const dateStr = r.scheduled_at ? new Date(r.scheduled_at).toLocaleString('fr-FR', { dateStyle: 'full', timeStyle: 'short' }) : '—';
      document.getElementById('next-card')!.innerHTML = `
        <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:10px;">
          <div style="font-family:'Jost'; font-weight:700;">${labels[r.service_type] ?? r.service_type}</div>
          <span style="font-size:0.72rem; font-weight:700; text-transform:uppercase; letter-spacing:1px; color:${statusColors[r.status] ?? 'var(--bovo-muted)'};">${statusLabels[r.status] ?? r.status}</span>
        </div>
        <div class="text-muted" style="margin-bottom:6px;">${dateStr}</div>
        <div style="font-family:'Jost'; font-weight:700; color: var(--bovo-bleu);">${fcfa(r.estimated_total_xof ?? 0)}</div>
      `;
    }

    document.getElementById('loading')!.hidden = true;
    document.getElementById('content')!.hidden = false;
  }
</script>
