---
import WorkerLayout from '@layouts/WorkerLayout.astro';
---
<WorkerLayout title="Mes missions — Bovo" pageTitle="Mes missions">
  <p style="color:var(--bovo-muted); font-size:0.9rem; margin-bottom:16px;">Vos missions assignées. Démarrez puis terminez chacune une fois sur place.</p>

  <div id="loading" style="text-align:center; padding:40px 16px; color:var(--bovo-muted);">Chargement…</div>

  <div id="active-wrap" hidden>
    <div id="active-list"></div>
  </div>

  <div id="empty" hidden class="empty-state">
    <div class="empty-state-emoji">🎉</div>
    <div class="empty-state-title">Aucune mission en cours</div>
    <div class="empty-state-desc">Vos prochaines affectations apparaîtront ici.</div>
  </div>

  <details id="done-wrap" hidden style="margin-top:18px;">
    <summary style="cursor:pointer; color:var(--bovo-muted); font-weight:600; font-size:0.9rem;">Missions terminées / annulées récemment</summary>
    <div id="done-list" style="margin-top:10px;"></div>
  </details>

  <!-- DÉTAIL MISSION -->
  <div id="mission-modal" hidden role="dialog" aria-modal="true" aria-labelledby="mission-title" style="position:fixed; inset:0; z-index: var(--z-modal); background: rgba(17,24,39,0.6); display:flex; align-items:flex-end; justify-content:center;">
    <div style="background:#fff; width:100%; max-width:560px; max-height:92vh; overflow-y:auto; border-radius: var(--r-xl) var(--r-xl) 0 0; padding:22px 18px calc(22px + env(safe-area-inset-bottom));">
      <div class="flex-between" style="margin-bottom:14px;">
        <h2 id="mission-title" style="font-family:'Jost'; font-weight:700; font-size:1.15rem;">Mission</h2>
        <button id="mission-close" class="topbar-back" aria-label="Fermer">✕</button>
      </div>
      <div id="mission-body"></div>
    </div>
  </div>
</WorkerLayout>

<script>
  import { getSupabase } from '@lib/supabase';
  import { getSessionUser } from '@lib/auth';
  import { SERVICE_LABELS, SERVICE_ICONS, STATUS_LABELS, STATUS_COLORS, escapeHtml } from '@lib/admin';

  const supa = getSupabase();
  if (!supa) {
    document.getElementById('loading')!.textContent = 'Service indisponible.';
  } else {
    const loadingEl = document.getElementById('loading')!;
    const activeWrap = document.getElementById('active-wrap')!;
    const activeList = document.getElementById('active-list')!;
    const doneWrap = document.getElementById('done-wrap')!;
    const doneList = document.getElementById('done-list')!;
    const emptyEl = document.getElementById('empty')!;
    const modal = document.getElementById('mission-modal')!;
    const modalTitle = document.getElementById('mission-title')!;
    const modalBody = document.getElementById('mission-body')!;

    let missions: any[] = [];

    function firstName(name: string | null): string {
      return (name ?? '').trim().split(/\s+/)[0] || 'Client';
    }
    function zoneOf(r: any): string {
      const a = r.payload?.address ?? r.payload?.from ?? {};
      return a.zone ?? a.quartier ?? '';
    }
    function fmtWhen(iso: string | null): string {
      if (!iso) return 'Date à définir';
      const d = new Date(iso);
      const now = new Date();
      const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
      const dDay = new Date(d.getFullYear(), d.getMonth(), d.getDate());
      const diff = Math.round((dDay.getTime() - today.getTime()) / 86400000);
      const time = d.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' });
      let day: string;
      if (diff === 0) day = "Aujourd'hui";
      else if (diff === 1) day = 'Demain';
      else if (diff === -1) day = 'Hier';
      else day = d.toLocaleDateString('fr-FR', { weekday: 'short', day: 'numeric', month: 'short' });
      return `${day} · ${time}`;
    }

    // ---- Rendu du lieu (aligné sur ce que l'admin/le client voient) ----
    function floorLabel(n: unknown): string {
      if (n === 0 || n === '0') return 'RDC';
      return n != null && n !== '' ? `${n}e étage` : '';
    }
    function addrText(a: any): string {
      if (!a) return '';
      return [a.street, a.building, a.quartier, a.zone].filter(Boolean).join(', ');
    }
    function mapsHref(a: any): string {
      const hasGeo = a && a.lat != null && a.lng != null && Number.isFinite(+a.lat) && Number.isFinite(+a.lng);
      const q = hasGeo ? `${a.lat},${a.lng}` : (addrText(a) || a?.zone || 'Cotonou, Bénin');
      return `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(q)}`;
    }
    function accessLines(a: any): string {
      if (!a) return '';
      const out: string[] = [];
      const fl = floorLabel(a.floor);
      if (fl) out.push(`Étage : ${fl}${a.elevator === true ? ' · ascenseur' : a.elevator === false ? ' · sans ascenseur' : ''}`);
      else if (a.elevator != null) out.push(`Ascenseur : ${a.elevator ? 'oui' : 'non'}`);
      if (a.parking) out.push(`Accès camion : ${String(a.parking)}`);
      return out.map((l) => `<div style="font-size:0.84rem; color:var(--bovo-muted); margin-top:2px;">${escapeHtml(l)}</div>`).join('');
    }
    const ACCESS_MODES: Record<string, string> = { 'cles-boite': 'Boîte à clés', code: 'Code serrure', gardien: 'Gardien', rdv: 'Rendez-vous' };
    function placeBlock(label: string, a: any): string {
      if (!a || typeof a !== 'object' || Object.keys(a).length === 0) return '';
      return `<div style="margin-bottom:10px;">
        <div style="font-weight:600; font-size:0.78rem; color:var(--bovo-muted); text-transform:uppercase; letter-spacing:0.5px;">${escapeHtml(label)}</div>
        <div style="font-size:0.92rem; margin:2px 0;">${escapeHtml(addrText(a) || 'Adresse non précisée')}</div>
        ${accessLines(a)}
        <a href="${mapsHref(a)}" target="_blank" rel="noopener" class="btn btn-ghost btn-sm" style="margin:6px 0 0;">🗺️ Itinéraire</a>
      </div>`;
    }

    function cardHtml(r: any): string {
      const z = zoneOf(r);
      return `
        <div class="mission-card" data-id="${escapeHtml(r.id)}" role="button" tabindex="0" style="background:#fff; border:1px solid var(--bovo-line-soft); border-left:4px solid ${STATUS_COLORS[r.status] ?? '#6B7280'}; border-radius:var(--r-lg); padding:14px; margin-bottom:10px; cursor:pointer;">
          <div style="display:flex; justify-content:space-between; align-items:center; gap:8px; margin-bottom:6px;">
            <span style="font-weight:600;">${SERVICE_ICONS[r.service_type] ?? '✦'} ${escapeHtml(SERVICE_LABELS[r.service_type] ?? r.service_type)}</span>
            <span class="status-badge" style="background:${STATUS_COLORS[r.status] ?? '#6B7280'};">${escapeHtml(STATUS_LABELS[r.status] ?? r.status)}</span>
          </div>
          <div style="font-weight:700; font-family:'Jost'; font-size:0.96rem;">${escapeHtml(fmtWhen(r.scheduled_at))}</div>
          <div style="color:var(--bovo-muted); font-size:0.86rem; margin-top:2px;">${escapeHtml(firstName(r.guest_name))}${z ? ` · ${escapeHtml(z)}` : ''}</div>
          ${r.status === 'assigned' ? (
            r.worker_declined_at ? '<div style="color:var(--bovo-danger); font-size:0.8rem; font-weight:600; margin-top:5px;">✗ Refusée — à réassigner</div>'
            : r.worker_accepted_at ? '<div style="color:var(--bovo-success); font-size:0.8rem; font-weight:600; margin-top:5px;">✓ Acceptée</div>'
            : '<div style="color:#B45309; font-size:0.8rem; font-weight:600; margin-top:5px;">● À confirmer</div>'
          ) : ''}
        </div>`;
    }

    function detailHtml(r: any): string {
      const p = r.payload ?? {};
      const isMove = r.service_type === 'demenagement';
      const digits = String(r.guest_phone ?? '').replace(/\D/g, '');

      // Lieu : déménagement = Départ + Arrivée ; sinon adresse unique. (building,
      // étage/ascenseur/accès camion et GPS lat/lng inclus — cf. placeBlock.)
      const locationHtml = isMove
        ? (placeBlock('Départ', p.from) + placeBlock('Arrivée', p.to)) || '<div style="font-size:0.9rem;">Adresse non précisée</div>'
        : (placeBlock('Adresse', p.address ?? p.from) || '<div style="font-size:0.9rem;">Adresse non précisée</div>');

      // Accès logement (Airbnb : boîte à clés / code / gardien…) — indispensable pour entrer.
      const acc = p.access;
      const accessHtml = (acc && typeof acc === 'object' && (acc.mode || acc.details)) ? `
        <div style="margin-top:6px; padding-top:8px; border-top:1px solid var(--bovo-line-soft);">
          <div style="font-weight:600; font-size:0.86rem;">🔑 Accès : ${escapeHtml(ACCESS_MODES[acc.mode] ?? acc.mode ?? '—')}</div>
          ${acc.details ? `<div style="font-size:0.86rem; margin-top:2px;">${escapeHtml(String(acc.details))}</div>` : ''}
        </div>` : '';

      // Autres détails : scalaires + tableaux de scalaires (ex. cuisines[] du chef).
      const SKIP = ['address', 'from', 'to', 'access'];
      const optionEntries = Object.entries(p)
        .filter(([k, v]) => !SKIP.includes(k) && v != null && v !== '')
        .map(([k, v]) => {
          let display = '';
          if (Array.isArray(v)) display = v.filter((x) => x != null && typeof x !== 'object').join(', ');
          else if (typeof v === 'object') return '';
          else display = String(v);
          if (!display) return '';
          return `<div style="display:flex; justify-content:space-between; gap:10px; padding:4px 0; border-bottom:1px solid var(--bovo-line-soft); font-size:0.86rem;"><span style="color:var(--bovo-muted);">${escapeHtml(k)}</span><span style="font-weight:600; text-align:right;">${escapeHtml(display)}</span></div>`;
        })
        .filter(Boolean)
        .join('');

      const row = (label: string, value: string) => `<div style="font-size:0.9rem; line-height:1.5;"><span style="color:var(--bovo-muted);">${label} :</span> ${value}</div>`;

      const accepted = !!r.worker_accepted_at;
      const declined = !!r.worker_declined_at;
      let action = '';
      if (r.status === 'cancelled') {
        action = `<div style="text-align:center; color:var(--bovo-danger); font-weight:600; padding:10px;">✗ Mission annulée par l'admin</div>`;
      } else if (r.status === 'done') {
        action = `<div style="text-align:center; color:var(--bovo-success); font-weight:600; padding:10px;">✓ Mission terminée</div>`;
      } else if (r.status === 'in_progress') {
        action = `<button id="act-done" class="btn btn-primary btn-block" type="button">✓ Terminer la mission</button>`;
      } else if (r.status === 'assigned') {
        if (declined) {
          action = `<div style="text-align:center; color:var(--bovo-danger); font-weight:600; padding:10px;">✗ Mission refusée${r.worker_decline_reason ? ` — ${escapeHtml(r.worker_decline_reason)}` : ''}<div style="color:var(--bovo-muted); font-weight:400; font-size:0.82rem; margin-top:4px;">En attente de réassignation par l'admin.</div></div>`;
        } else if (accepted) {
          action = `<button id="act-start" class="btn btn-primary btn-block" type="button">▶ Démarrer la mission</button>`;
        } else {
          action = `<div style="display:flex; gap:8px;"><button id="act-accept" class="btn btn-primary btn-sm" type="button" style="flex:1;">✓ Accepter</button><button id="act-decline" class="btn btn-ghost btn-sm" type="button" style="flex:1; color:var(--bovo-danger);">✗ Refuser</button></div>`;
        }
      }

      return `
        <div style="display:flex; gap:8px; align-items:center; margin-bottom:14px;">
          <span class="status-badge" style="background:${STATUS_COLORS[r.status] ?? '#6B7280'};">${escapeHtml(STATUS_LABELS[r.status] ?? r.status)}</span>
          <strong style="font-family:'Jost';">${escapeHtml(fmtWhen(r.scheduled_at))}</strong>
        </div>

        <h3 style="font-family:'Jost'; font-weight:700; margin-bottom:8px;">Client</h3>
        <div style="background:var(--bovo-bg-soft); padding:12px; border-radius:var(--r-md); margin-bottom:16px;">
          ${row('Nom', `<strong>${escapeHtml(r.guest_name ?? '—')}</strong>`)}
          ${row('Téléphone', digits ? `<a href="tel:${escapeHtml(digits)}" style="color:var(--bovo-bleu); font-weight:600;">${escapeHtml(r.guest_phone)}</a> · <a href="https://wa.me/${escapeHtml(digits)}" target="_blank" rel="noopener" style="color:var(--bovo-success); font-weight:600;">WhatsApp</a>` : '—')}
        </div>

        <h3 style="font-family:'Jost'; font-weight:700; margin-bottom:8px;">Lieu</h3>
        <div style="background:var(--bovo-bg-soft); padding:12px; border-radius:var(--r-md); margin-bottom:16px;">
          ${locationHtml}
          ${accessHtml}
        </div>

        ${optionEntries ? `
        <h3 style="font-family:'Jost'; font-weight:700; margin-bottom:8px;">Détails de la prestation</h3>
        <div style="background:var(--bovo-bg-soft); padding:12px; border-radius:var(--r-md); margin-bottom:18px;">${optionEntries}</div>` : ''}

        <div id="mission-feedback" style="font-size:0.85rem; margin-bottom:10px;"></div>
        ${action}`;
    }

    async function load() {
      loadingEl.hidden = false;
      activeWrap.hidden = true; emptyEl.hidden = true; doneWrap.hidden = true;

      const user = await getSessionUser();
      if (!user) { loadingEl.textContent = 'Session expirée.'; return; }

      const since = new Date(); since.setDate(since.getDate() - 14);
      // Lecture via la vue worker_missions : colonnes restreintes (pas de guest_email
      // / montant / deposit_*) et déjà filtrée sur assigned_worker_id = auth.uid()
      // (cf. migration 20260619). Le worker n'a plus de SELECT direct sur reservations.
      const { data, error } = await supa.from('worker_missions')
        .select('id, service_type, guest_name, guest_phone, scheduled_at, duration_min, status, payload, worker_accepted_at, worker_declined_at, worker_decline_reason')
        .in('status', ['assigned', 'in_progress', 'done', 'cancelled'])
        // Inclure les missions sans date (« date à définir ») : .gte exclurait les NULL
        // → une mission assignée sans scheduled_at serait invisible pour le worker.
        .or(`scheduled_at.is.null,scheduled_at.gte.${since.toISOString()}`)
        .order('scheduled_at', { ascending: true });

      loadingEl.hidden = true;
      if (error) { loadingEl.textContent = `Erreur : ${error.message}`; loadingEl.hidden = false; return; }

      missions = data ?? [];
      const active = missions.filter((r) => r.status === 'assigned' || r.status === 'in_progress');
      const done = missions.filter((r) => r.status === 'done' || r.status === 'cancelled').reverse(); // terminées/annulées, plus récentes d'abord

      if (active.length === 0) emptyEl.hidden = false;
      else { activeList.innerHTML = active.map(cardHtml).join(''); activeWrap.hidden = false; }

      if (done.length) { doneList.innerHTML = done.map(cardHtml).join(''); doneWrap.hidden = false; }

      [activeList, doneList].forEach((el) => el.querySelectorAll<HTMLElement>('.mission-card').forEach((c) => {
        c.addEventListener('click', () => openMission(c.dataset.id!));
        c.addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Enter') openMission(c.dataset.id!); });
      }));
    }

    function openMission(id: string) {
      const r = missions.find((m) => m.id === id);
      if (!r) return;
      modalTitle.textContent = SERVICE_LABELS[r.service_type] ?? 'Mission';
      modalBody.innerHTML = detailHtml(r);
      modal.hidden = false;

      const start = document.getElementById('act-start');
      const done = document.getElementById('act-done');
      const accept = document.getElementById('act-accept');
      const decline = document.getElementById('act-decline');
      if (start) start.addEventListener('click', () => advance(r, 'in_progress'));
      if (done) done.addEventListener('click', () => advance(r, 'done'));
      if (accept) accept.addEventListener('click', () => respond(r, 'accept'));
      if (decline) decline.addEventListener('click', () => showDeclineForm(r));
    }

    async function respond(r: any, _kind: 'accept') {
      const fb = document.getElementById('mission-feedback');
      const patch = { worker_accepted_at: new Date().toISOString(), worker_declined_at: null, worker_decline_reason: null };
      if (fb) { fb.textContent = 'Enregistrement…'; fb.style.color = 'var(--bovo-muted)'; }
      const { error } = await supa.from('reservations').update(patch).eq('id', r.id);
      if (error) { if (fb) { fb.textContent = `Erreur : ${error.message}`; fb.style.color = 'var(--bovo-danger)'; } return; }
      modal.hidden = true;
      await load();
    }

    // Refus : saisie du motif via un champ inline stylé (pas de prompt() natif, hors charte).
    function showDeclineForm(r: any) {
      const fb = document.getElementById('mission-feedback');
      if (!fb) return;
      const declineBtn = document.getElementById('act-decline');
      if (declineBtn?.parentElement) (declineBtn.parentElement as HTMLElement).style.display = 'none';
      fb.innerHTML = `
        <label class="field-label" for="decline-reason">Motif du refus (optionnel)</label>
        <textarea id="decline-reason" class="textarea" placeholder="Ex. indisponible, trop loin…"></textarea>
        <div style="display:flex; gap:8px; margin-top:8px;">
          <button id="decline-confirm" type="button" class="btn btn-sm" style="flex:1; background:var(--bovo-danger); color:#fff;">Confirmer le refus</button>
          <button id="decline-cancel" type="button" class="btn btn-ghost btn-sm" style="flex:1;">Annuler</button>
        </div>
        <div id="decline-fb" style="font-size:0.82rem; margin-top:6px;"></div>`;
      document.getElementById('decline-confirm')!.addEventListener('click', () => {
        const reason = (document.getElementById('decline-reason') as HTMLTextAreaElement).value.trim();
        void submitDecline(r, reason);
      });
      document.getElementById('decline-cancel')!.addEventListener('click', () => openMission(r.id));
    }

    async function submitDecline(r: any, reason: string) {
      const fb = document.getElementById('decline-fb');
      if (fb) { fb.textContent = 'Enregistrement…'; fb.style.color = 'var(--bovo-muted)'; }
      const { error } = await supa.from('reservations')
        .update({ worker_declined_at: new Date().toISOString(), worker_accepted_at: null, worker_decline_reason: reason || null })
        .eq('id', r.id);
      if (error) { if (fb) { fb.textContent = `Erreur : ${error.message}`; fb.style.color = 'var(--bovo-danger)'; } return; }
      modal.hidden = true;
      await load();
    }

    async function advance(r: any, next: 'in_progress' | 'done') {
      const fb = document.getElementById('mission-feedback');
      const btn = document.getElementById(next === 'in_progress' ? 'act-start' : 'act-done') as HTMLButtonElement | null;
      if (btn) btn.disabled = true;
      if (fb) { fb.textContent = 'Enregistrement…'; fb.style.color = 'var(--bovo-muted)'; }
      const { error } = await supa.from('reservations')
        .update({ status: next }).eq('id', r.id);
      if (error) {
        if (btn) btn.disabled = false;
        if (fb) { fb.textContent = `Erreur : ${error.message}`; fb.style.color = 'var(--bovo-danger)'; }
        return;
      }
      // Le trigger BEFORE UPDATE refuse une transition invalide SANS erreur (il remet
      // l'ancien statut). Le worker n'ayant plus de SELECT direct sur reservations, on
      // relit le statut réellement enregistré via la vue worker_missions pour ne pas
      // afficher un faux succès.
      const { data: check } = await supa.from('worker_missions')
        .select('status').eq('id', r.id).maybeSingle();
      if (check?.status !== next) {
        if (btn) btn.disabled = false;
        if (fb) { fb.textContent = 'Action impossible : le statut de la mission a changé entre-temps. Liste actualisée.'; fb.style.color = 'var(--bovo-danger)'; }
        await load();
        return;
      }
      modal.hidden = true;
      await load();
    }

    document.getElementById('mission-close')!.addEventListener('click', () => modal.hidden = true);
    modal.addEventListener('click', (e) => { if (e.target === modal) modal.hidden = true; });
    document.addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Escape' && !modal.hidden) modal.hidden = true; });

    await load();

    // Deep-link push (notif « nouvelle mission ») : ouvrir directement la mission tapée.
    const deepMission = new URLSearchParams(location.search).get('mission');
    if (deepMission) { openMission(deepMission); history.replaceState(null, '', location.pathname); }
  }
</script>
