---
import Layout from '@layouts/Layout.astro';
import Stepper from '@components/Stepper.astro';
import CtaFooter from '@components/CtaFooter.astro';
import Icon from '@components/Icon.astro';
---
<Layout
  title="Chef — Récapitulatif | Bovo"
  topbar="back"
  backHref="/chef/contact/"
  pageTitle="Chef à domicile"
  noindex
  transitions
>
  <Fragment slot="topbar-extra"><Stepper total={7} current={7} /></Fragment>

  <h1 class="h-display" style="margin-bottom:8px;">Récapitulatif</h1>
  <p class="text-lead" style="margin-bottom:24px;">Votre proposition de chef sous 48h.</p>

  <div class="stack-md" id="recap-cards"></div>

  <div id="deposit-block" hidden class="card card-elevated" style="margin-top:18px; padding:18px; background: var(--bovo-bleu-light); border-color: transparent;">
    <div style="display:flex; gap:12px; align-items:flex-start;">
      <div style="flex-shrink:0; color: var(--bovo-bleu);"><Icon name="shield" size={20} /></div>
      <div style="flex:1;">
        <div style="font-weight:600; margin-bottom:4px;">Acompte de 20% pour verrouiller la mission</div>
        <div class="text-muted">Vous paierez <strong id="deposit-amount" style="color: var(--bovo-ink);">—</strong> par Mobile Money (MTN/Moov) ou carte.</div>
      </div>
    </div>
  </div>

  <CtaFooter buttonLabel="Envoyer ma demande" buttonType="button" buttonId="cta-submit" priceLabel="Forfait mensuel" priceValue="—" variant="rouge" />
</Layout>

<!-- is:inline obligatoire : sans ça Astro transforme ce script externe en
     `import "https://cdn.kkiapay.me/k.js"` (module ES cross-origin) qui échoue,
     donc window.openKkiapayWidget n'est jamais défini → acompte mort. -->
<script is:inline src="https://cdn.kkiapay.me/k.js"></script>

<script>
  import { loadState, type ChefState } from '@lib/state';
  import { getSupabase } from '@lib/supabase';
  import { getCurrentUserId, submitReservation, submitAndRedirect, navigateAfterSubmit, whatsappUrl, isOffline, showSubmitError } from '@lib/tunnel';
  import { openDeposit, isKkiapayReady, confirmDeposit, type KkiapayResponse } from '@lib/kkiapay';
  import { CHEF_FREQUENCES, CHEF_DUREES, CHEF_CUISINES, fcfa } from '@lib/catalog';

  function init() {
  if (!document.getElementById('recap-cards')) return;

  const s = loadState<ChefState>('chef');

  // Garde d'étapes : recap atteint sans données → retour au début du tunnel.
  if (!s.frequence || !s.customer?.phone) { window.location.href = '/chef/'; return; }
  const freq = CHEF_FREQUENCES.find((f) => f.id === s.frequence);
  const duree = CHEF_DUREES.find((d) => d.id === s.duree);
  const cuisinesLabels = (s.cuisines ?? []).map((id) => CHEF_CUISINES.find((c) => c.id === id)?.label).filter(Boolean);
  const monthly = Math.round((freq?.baseXof ?? 0) * (duree?.multiplier ?? 1));
  const deposit = Math.round(monthly * 0.2);

  function row(label: string, value: string) {
    return `
      <div class="flex-between" style="padding:10px 0; border-bottom:1px solid var(--bovo-line-soft);">
        <span class="text-muted" style="font-size:0.84rem;">${label}</span>
        <span style="font-weight:600; text-align:right;">${value}</span>
      </div>
    `;
  }

  document.getElementById('recap-cards')!.innerHTML = `
    <div class="card card-elevated">
      <div style="font-family:'Jost'; font-weight:700; font-size:1rem; margin-bottom:6px;">Votre formule</div>
      ${row('Fréquence', freq?.label ?? '—')}
      ${row('Durée d\'engagement', duree?.label ?? '—')}
      ${row('Style de cuisine', cuisinesLabels.join(', ') || '—')}
      ${row('Personnes au foyer', String(s.people ?? '—'))}
      ${s.diet ? row('Allergies/régime', s.diet) : ''}
    </div>
    <div class="card card-elevated">
      <div style="font-family:'Jost'; font-weight:700; font-size:1rem; margin-bottom:6px;">Démarrage et adresse</div>
      ${row('Démarrage', s.startDate ?? '—')}
      ${row('Zone', s.address?.zone ?? '—')}
      ${s.address?.quartier ? row('Quartier', s.address.quartier) : ''}
      ${row('Adresse', s.address?.street ?? '—')}
      ${s.address?.building ? row('Précisions', s.address.building) : ''}
    </div>
    <div class="card card-elevated">
      <div style="font-family:'Jost'; font-weight:700; font-size:1rem; margin-bottom:6px;">Vos coordonnées</div>
      ${row('Nom', s.customer?.fullName ?? '—')}
      ${row('Téléphone', s.customer?.phone ?? '—')}
      ${row('Email', s.customer?.email ?? '—')}
      ${s.customer?.notes ? row('Notes', s.customer.notes) : ''}
    </div>
  `;

  document.querySelector('.cta-footer .price-line strong')!.textContent = `${fcfa(monthly)}/mois`;

  if (s.wantsDeposit) {
    document.getElementById('deposit-block')!.hidden = false;
    document.getElementById('deposit-amount')!.textContent = fcfa(deposit);
  }

  const cta = document.getElementById('cta-submit') as HTMLButtonElement;

  function buildWhatsappMessage(): string {
    const lines = [
      '*Nouvelle demande Bovo — Chef à domicile*',
      '',
      `Fréquence : ${freq?.label}`,
      `Engagement : ${duree?.label}`,
      `Style de cuisine : ${cuisinesLabels.join(', ')}`,
      `Personnes : ${s.people}`,
      s.diet ? `Régime/allergies : ${s.diet}` : '',
      '',
      `Démarrage : ${s.startDate}`,
      `Adresse : ${s.address?.street}${s.address?.quartier ? `, ${s.address.quartier}` : ''}, ${s.address?.zone}`,
      s.address?.building ? `Précisions : ${s.address.building}` : '',
      s.address?.lat && s.address?.lng ? `📍 https://maps.google.com/?q=${s.address.lat},${s.address.lng}` : '',
      '',
      `Client : ${s.customer?.fullName}`,
      `Tél : ${s.customer?.phone}`,
      `Email : ${s.customer?.email}`,
      s.customer?.notes ? `Notes : ${s.customer.notes}` : '',
      '',
      `*Forfait mensuel : ${fcfa(monthly)}*`,
      s.wantsDeposit ? `Acompte 20% souhaité : ${fcfa(deposit)}` : '',
    ];
    return lines.filter(Boolean).join('\n');
  }

  // Le client ne peut écrire que 'none' ou 'pending' : le passage à 'paid' et
  // l'enregistrement du tx Kkiapay se font côté serveur après vérification (cf. RLS).
  function buildPayload(depositStatus: 'none' | 'pending') {
    return {
      service_type: 'chef',
      payload: {
        frequence: s.frequence, duree: s.duree, cuisines: s.cuisines ?? [],
        people: s.people, diet: s.diet, startDate: s.startDate, address: s.address,
      },
      estimated_total_xof: monthly,
      guest_name: s.customer?.fullName,
      guest_phone: s.customer?.phone,
      guest_email: s.customer?.email,
      scheduled_at: s.startDate ? new Date(`${s.startDate}T09:00:00`).toISOString() : null,
      status: 'pending',
      deposit_status: depositStatus,
      deposit_kkiapay_tx: null,
    };
  }

  cta.addEventListener('click', () => {
    // Avec acompte : passage par le widget Kkiapay (sandbox piloté par l'env, jamais 'paid' en dur).
    if (s.wantsDeposit && isKkiapayReady()) {
      if (isOffline()) {
        showSubmitError('Vous semblez hors-ligne. Vérifiez votre connexion et réessayez — vos informations sont conservées.');
        return;
      }
      cta.disabled = true;
      cta.textContent = 'Envoi en cours…';
      // id généré AVANT le widget : un invité ne peut pas relire sa résa (RLS) et on
      // le passe à Kkiapay via `data` pour LIER le paiement à CETTE résa (confirm-deposit
      // vérifie la correspondance côté serveur, en plus du montant et de l'usage unique).
      const reservationId = crypto.randomUUID();
      const finish = async (depositStatus: 'none' | 'pending', resp?: KkiapayResponse) => {
        const supa = getSupabase();
        const userId = await getCurrentUserId(supa);
        const res = await submitReservation(supa, { id: reservationId, ...buildPayload(depositStatus), user_id: userId });
        // Acompte réellement encaissé → confirmation serveur (vérif Kkiapay → 'paid').
        if (res.ok && depositStatus === 'pending' && resp?.transactionId) {
          await confirmDeposit(reservationId, resp.transactionId);
        }
        navigateAfterSubmit('chef', whatsappUrl(buildWhatsappMessage()), s.customer);
      };
      openDeposit({
        amountXof: deposit,
        reservationId,
        customerName: s.customer?.fullName,
        customerEmail: s.customer?.email,
        customerPhone: s.customer?.phone,
        reason: 'Acompte chef Bovo',
        onSuccess: (resp) => finish('pending', resp),
        onFailed: () => finish('none'),
      });
    } else {
      void submitAndRedirect({
        service: 'chef',
        payload: buildPayload(s.wantsDeposit ? 'pending' : 'none'),
        message: buildWhatsappMessage(),
        customer: s.customer,
        cta,
      });
    }
  });

  }
  document.addEventListener('astro:page-load', init);</script>
