---
import Layout from '@layouts/Layout.astro';
import Stepper from '@components/Stepper.astro';
import CtaFooter from '@components/CtaFooter.astro';
import { PLOMBIER_TYPES, fcfa } from '@lib/catalog';
---
<Layout
  title="Plombier à domicile — Étape 1 : Type d'intervention | Bovo"
  topbar="back"
  backHref="/"
  pageTitle="Plombier à domicile"
  noindex
>
  <Fragment slot="topbar-extra">
    <Stepper total={6} current={1} />
  </Fragment>

  <h1 class="h-display" style="margin-bottom:8px;">De quel type d'intervention avez-vous besoin&nbsp;?</h1>
  <p class="text-lead" style="margin-bottom:24px;">Sélectionnez la situation la plus proche — vous pourrez préciser ensuite.</p>

  <div class="stack-sm" id="type-list">
    {PLOMBIER_TYPES.map((t) => (
      <button class="opt" data-value={t.id} data-price={t.priceXof} data-duration={t.durationMin}>
        <span class="opt-radio"></span>
        <span class="opt-body">
          <span class="opt-title">{t.label}</span>
          <span class="opt-meta">{t.meta}</span>
        </span>
        <span class="opt-meta" style="font-size:0.78rem;">dès {fcfa(t.priceXof)}</span>
      </button>
    ))}
  </div>

  <div class="field" style="margin-top:24px;">
    <label class="field-label" for="description">Précisez votre problème (optionnel)</label>
    <textarea id="description" class="textarea" placeholder="ex. fuite sous l'évier de la cuisine depuis ce matin, eau qui coule en continu"></textarea>
  </div>

  <CtaFooter
    buttonLabel="Continuer"
    buttonType="button"
    buttonId="cta-next"
    disabled={true}
  />
</Layout>

<script>
  import { loadState, saveState, type PlombierState } from '@lib/state';

  const list = document.getElementById('type-list')!;
  const desc = document.getElementById('description') as HTMLTextAreaElement;
  const cta = document.getElementById('cta-next') as HTMLButtonElement;

  const s = loadState<PlombierState>('plombier');
  let current = s.type ?? '';
  desc.value = s.description ?? '';

  function render() {
    list.querySelectorAll<HTMLButtonElement>('.opt').forEach((el) => {
      el.classList.toggle('is-active', el.dataset.value === current);
    });
    cta.disabled = !current;
  }

  list.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.opt');
    if (!btn) return;
    current = btn.dataset.value!;
    saveState<PlombierState>('plombier', { type: current });
    render();
  });

  desc.addEventListener('input', () => {
    saveState<PlombierState>('plombier', { description: desc.value.trim() || undefined });
  });

  cta.addEventListener('click', () => {
    if (!current) return;
    window.location.href = '/plombier/options/';
  });

  render();
</script>
