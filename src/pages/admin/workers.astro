---
import AdminLayout from '@layouts/AdminLayout.astro';
import { ZONES } from '@lib/catalog';
---
<AdminLayout title="Workers — Bovo Admin" pageTitle="Workers" active="workers">
  <p class="admin-sub">Vos équipes terrain : skills, zones d'intervention, disponibilités, congés.</p>

  <div style="display:flex; gap:8px; margin-bottom:18px; align-items:center; flex-wrap:wrap;">
    <input id="search" class="input" type="text" placeholder="Rechercher un worker par nom ou téléphone…" style="max-width:380px; flex:1; min-width:200px;" />
    <button id="create-btn" class="btn btn-primary btn-sm">+ Nouveau worker</button>
    <button id="promote-btn" class="btn btn-ghost btn-sm">Promouvoir un user</button>
    <label style="display:flex; align-items:center; gap:6px; font-size:0.86rem; color:var(--bovo-muted); cursor:pointer; white-space:nowrap;">
      <input id="active-only" type="checkbox" /> Actifs seulement
    </label>
  </div>

  <div id="list-loading" style="color: var(--bovo-muted); padding: 24px; text-align:center;">Chargement…</div>

  <table id="list-table" class="admin-table admin-table-mobile" hidden>
    <thead>
      <tr>
        <th>Nom</th>
        <th>Téléphone</th>
        <th>Rôle</th>
        <th>Skills</th>
        <th>Zones</th>
        <th>Note</th>
      </tr>
    </thead>
    <tbody id="list-body"></tbody>
  </table>

  <div id="list-mobile" class="mobile-cards" hidden></div>

  <div id="list-empty" hidden class="empty-state">
    <div class="empty-state-emoji">👥</div>
    <div class="empty-state-title">Aucun worker enregistré</div>
    <div class="empty-state-desc">Cliquez "+ Nouveau worker" pour créer votre première équipe.</div>
  </div>

  <!-- MODAL PROMOTION -->
  <div id="promote-modal" hidden style="position:fixed; inset:0; z-index: var(--z-modal); background: rgba(17,24,39,0.6); display:flex; align-items:center; justify-content:center; padding:20px;">
    <div style="background:#fff; width:100%; max-width:520px; border-radius: var(--r-xl); padding:24px;">
      <div class="flex-between" style="margin-bottom:16px;">
        <h2 style="font-family:'Jost'; font-weight:700;">Promouvoir un utilisateur</h2>
        <button id="promote-close" class="topbar-back" aria-label="Fermer">✕</button>
      </div>
      <p class="text-muted" style="margin-bottom:16px;">L'utilisateur doit déjà avoir créé un compte Bovo (via /compte/inscription). Sélectionnez-le dans la liste pour le passer en role 'worker'.</p>
      <div class="field">
        <label class="field-label">Choisir un utilisateur</label>
        <select id="promote-select" class="select">
          <option value="">Chargement…</option>
        </select>
      </div>
      <div id="promote-error" style="color:var(--bovo-danger); display:none; margin:8px 0;"></div>
      <button id="promote-save" class="btn btn-primary btn-block">Promouvoir en worker</button>
    </div>
  </div>

  <!-- MODAL CRÉATION WORKER (W1) -->
  <div id="create-modal" hidden style="position:fixed; inset:0; z-index: var(--z-modal); background: rgba(17,24,39,0.6); display:flex; align-items:center; justify-content:center; padding:20px;">
    <div style="background:#fff; width:100%; max-width:560px; max-height:90vh; overflow-y:auto; border-radius: var(--r-xl); padding:24px;">
      <div class="flex-between" style="margin-bottom:16px;">
        <h2 style="font-family:'Jost'; font-weight:700;">Nouveau worker</h2>
        <button id="create-close" class="topbar-back" aria-label="Fermer">✕</button>
      </div>

      <div id="create-form">
        <p class="text-muted" style="margin-bottom:16px;">Crée le compte de A à Z, sans que la personne ait à s'inscrire elle-même. Il devient aussitôt assignable par le matching.</p>

        <div class="field">
          <label class="field-label" for="cw-name">Nom complet <span style="color:var(--bovo-danger);">*</span></label>
          <input id="cw-name" class="input" type="text" autocomplete="off" placeholder="Awa Koné" />
        </div>
        <div class="field">
          <label class="field-label" for="cw-phone">Téléphone <span style="color:var(--bovo-danger);">*</span></label>
          <input id="cw-phone" class="input" type="tel" autocomplete="off" placeholder="+229 01 96 00 00 00" />
        </div>
        <div class="field">
          <label class="field-label" for="cw-email">Email <span class="text-muted" style="font-weight:400;">(optionnel)</span></label>
          <input id="cw-email" class="input" type="email" autocomplete="off" placeholder="awa@exemple.bj" />
          <div class="text-muted" style="font-size:0.8rem; margin-top:6px; line-height:1.4;">Avec email : le worker pourra se connecter (un mot de passe temporaire s'affichera ici). Sans email : compte géré par l'admin, login activable plus tard.</div>
        </div>

        <div class="field">
          <label class="field-label">Services</label>
          <div id="cw-skills" style="display:flex; gap:8px; flex-wrap:wrap;"></div>
        </div>
        <div class="field">
          <label class="field-label">Zones d'intervention</label>
          <div id="cw-zones" style="display:flex; gap:8px; flex-wrap:wrap;"></div>
        </div>

        <div id="create-error" style="color:var(--bovo-danger); display:none; margin:8px 0;"></div>
        <button id="create-save" class="btn btn-primary btn-block">Créer le worker</button>
      </div>

      <div id="create-success" hidden></div>
    </div>
  </div>

  <!-- MODAL DÉTAIL WORKER -->
  <div id="worker-modal" hidden style="position:fixed; inset:0; z-index: var(--z-modal); background: rgba(17,24,39,0.6); display:flex; align-items:center; justify-content:center; padding:20px;">
    <div style="background:#fff; width:100%; max-width:720px; max-height:90vh; overflow-y:auto; border-radius: var(--r-xl); padding:24px;">
      <div class="flex-between" style="margin-bottom:16px;">
        <h2 id="worker-modal-title" style="font-family:'Jost'; font-weight:700;">Worker</h2>
        <button id="worker-modal-close" class="topbar-back" aria-label="Fermer">✕</button>
      </div>
      <div id="worker-modal-body"></div>
    </div>
  </div>
</AdminLayout>

<script>
  import { getSupabase } from '@lib/supabase';
  import { ZONES } from '@lib/catalog';
  import { escapeHtml, createWorker } from '@lib/admin';

  const supa = getSupabase();
  if (!supa) {
    document.getElementById('list-loading')!.textContent = 'Supabase non configuré.';
  } else {
    const SKILLS = ['menage', 'airbnb', 'demenagement', 'chef', 'plombier'] as const;
    const SKILL_LABELS: Record<string, string> = {
      menage: '🧹 Ménage', airbnb: '🏠 Airbnb', demenagement: '🚚 Déménagement', chef: '👨‍🍳 Chef', plombier: '🔧 Plombier',
    };
    const DAYS = ['Dim', 'Lun', 'Mar', 'Mer', 'Jeu', 'Ven', 'Sam'];

    const searchInput = document.getElementById('search') as HTMLInputElement;
    const tableBody = document.getElementById('list-body')!;
    const tableEl = document.getElementById('list-table')!;
    const mobileEl = document.getElementById('list-mobile')!;
    const emptyEl = document.getElementById('list-empty')!;
    const loadingEl = document.getElementById('list-loading')!;

    const promoteModal = document.getElementById('promote-modal')!;
    const promoteSelect = document.getElementById('promote-select') as HTMLSelectElement;
    const promoteErr = document.getElementById('promote-error')!;

    const workerModal = document.getElementById('worker-modal')!;
    const workerModalTitle = document.getElementById('worker-modal-title')!;
    const workerModalBody = document.getElementById('worker-modal-body')!;

    async function load() {
      loadingEl.hidden = false;
      tableEl.hidden = true;
      mobileEl.hidden = true;
      emptyEl.hidden = true;

      const search = searchInput.value.trim().toLowerCase();
      const { data, error } = await supa.from('profiles').select('*').in('role', ['worker', 'admin']).order('full_name');
      loadingEl.hidden = true;
      if (error) {
        loadingEl.textContent = `Erreur : ${error.message}`;
        loadingEl.hidden = false;
        return;
      }

      let workers = data ?? [];
      if (search) {
        workers = workers.filter((w: any) => (w.full_name ?? '').toLowerCase().includes(search) || (w.phone ?? '').includes(search));
      }

      if (workers.length === 0) {
        emptyEl.hidden = false;
        return;
      }

      // Fetch skills, zones et reviews pour tous les workers
      const ids = workers.map((w: any) => w.id);
      const [{ data: skills }, { data: zones }, { data: reviewRows }, { data: statusRows }] = await Promise.all([
        supa.from('worker_skills').select('worker_id, skill').in('worker_id', ids),
        supa.from('worker_zones').select('worker_id, zone').in('worker_id', ids),
        supa.from('reviews').select('worker_id, rating').in('worker_id', ids),
        supa.from('worker_profiles').select('worker_id, status').in('worker_id', ids),
      ]);

      const statusMap = new Map<string, string>();
      (statusRows ?? []).forEach((s: any) => statusMap.set(s.worker_id, s.status ?? 'active'));
      const workerStatus = (wid: string) => statusMap.get(wid) ?? 'active';
      function statusBadge(wid: string) {
        const st = workerStatus(wid);
        if (st === 'suspended') return ' <span class="status-badge" style="background:#F59E0B;">Suspendu</span>';
        if (st === 'archived') return ' <span class="status-badge" style="background:#6B7280;">Archivé</span>';
        return '';
      }

      // Filtre « actifs seulement » (W3) : par défaut on affiche tout le monde
      // (avec badge), le filtre masque les suspendus/archivés.
      if ((document.getElementById('active-only') as HTMLInputElement)?.checked) {
        workers = workers.filter((w: any) => workerStatus(w.id) === 'active');
        if (workers.length === 0) { emptyEl.hidden = false; return; }
      }

      const skillsMap = new Map<string, string[]>();
      (skills ?? []).forEach((s: any) => {
        const arr = skillsMap.get(s.worker_id) ?? [];
        arr.push(s.skill);
        skillsMap.set(s.worker_id, arr);
      });
      const zonesMap = new Map<string, string[]>();
      (zones ?? []).forEach((z: any) => {
        const arr = zonesMap.get(z.worker_id) ?? [];
        arr.push(z.zone);
        zonesMap.set(z.worker_id, arr);
      });
      const reviewMap = new Map<string, { count: number; sum: number }>();
      (reviewRows ?? []).forEach((rv: any) => {
        const agg = reviewMap.get(rv.worker_id) ?? { count: 0, sum: 0 };
        agg.count += 1;
        agg.sum += rv.rating;
        reviewMap.set(rv.worker_id, agg);
      });
      function ratingCell(workerId: string) {
        const agg = reviewMap.get(workerId);
        if (!agg || agg.count === 0) return '<span style="color:var(--bovo-muted);">—</span>';
        const avg = (agg.sum / agg.count).toFixed(1).replace('.', ',');
        return `<span style="font-weight:600;"><span style="color:#f5b400;">★</span> ${avg}<span style="color:var(--bovo-muted); font-weight:400;"> (${agg.count})</span></span>`;
      }

      tableBody.innerHTML = workers.map((w: any) => {
        const ws = skillsMap.get(w.id) ?? [];
        const wz = zonesMap.get(w.id) ?? [];
        return `
          <tr data-id="${w.id}">
            <td><strong>${escapeHtml(w.full_name ?? '—')}</strong>${statusBadge(w.id)}</td>
            <td>${escapeHtml(w.phone ?? '—')}</td>
            <td>${w.role === 'admin' ? '<span class="status-badge" style="background:var(--bovo-rouge);">Admin</span>' : '<span class="status-badge" style="background:var(--bovo-bleu);">Worker</span>'}</td>
            <td style="font-size:0.84rem;">${ws.length ? ws.map((s: string) => SKILL_LABELS[s] ?? s).join(', ') : '<span style="color:var(--bovo-muted);">—</span>'}</td>
            <td style="font-size:0.84rem;">${wz.length ? wz.join(', ') : '<span style="color:var(--bovo-muted);">—</span>'}</td>
            <td style="font-size:0.84rem;">${ratingCell(w.id)}</td>
          </tr>
        `;
      }).join('');
      tableEl.hidden = false;

      mobileEl.innerHTML = workers.map((w: any) => {
        const ws = skillsMap.get(w.id) ?? [];
        const wz = zonesMap.get(w.id) ?? [];
        return `
          <div data-id="${w.id}" style="background:#fff; border:1px solid var(--bovo-line-soft); border-radius:var(--r-lg); padding:14px; margin-bottom:10px;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:6px;">
              <span><strong>${escapeHtml(w.full_name ?? '—')}</strong>${statusBadge(w.id)}</span>
              ${w.role === 'admin' ? '<span class="status-badge" style="background:var(--bovo-rouge);">Admin</span>' : '<span class="status-badge" style="background:var(--bovo-bleu);">Worker</span>'}
            </div>
            <div style="font-size:0.84rem; color:var(--bovo-muted); margin-bottom:6px;">${escapeHtml(w.phone ?? '—')}</div>
            <div style="font-size:0.82rem;">${ws.length ? ws.map((s: string) => SKILL_LABELS[s] ?? s).join(', ') : 'Aucun skill'}</div>
            <div style="font-size:0.82rem; color:var(--bovo-muted); margin-top:2px;">${wz.length ? wz.join(', ') : 'Aucune zone'}</div>
            <div style="font-size:0.82rem; margin-top:6px;">${ratingCell(w.id)}</div>
          </div>
        `;
      }).join('');
      mobileEl.hidden = false;

      [...tableBody.querySelectorAll('tr[data-id]'), ...mobileEl.querySelectorAll('[data-id]')].forEach((el) => {
        el.addEventListener('click', () => openWorkerModal(el.getAttribute('data-id')!));
      });
    }

    async function openWorkerModal(id: string) {
      workerModalBody.innerHTML = '<div style="text-align:center; padding:40px; color:var(--bovo-muted);">Chargement…</div>';
      workerModal.hidden = false;

      const [{ data: prof }, { data: skills }, { data: zones }, { data: avail }, { data: blackouts }, { data: reviewsList }, { data: rh }] = await Promise.all([
        supa.from('profiles').select('*').eq('id', id).maybeSingle(),
        supa.from('worker_skills').select('*').eq('worker_id', id),
        supa.from('worker_zones').select('*').eq('worker_id', id),
        supa.from('worker_availability').select('*').eq('worker_id', id).order('day_of_week'),
        supa.from('worker_blackouts').select('*').eq('worker_id', id).order('starts_at'),
        supa.from('reviews').select('rating, comment, service_type, created_at').eq('worker_id', id).order('created_at', { ascending: false }).limit(20),
        supa.from('worker_profiles').select('*').eq('worker_id', id).maybeSingle(),
      ]);

      if (!prof) {
        workerModalBody.innerHTML = '<div style="color:var(--bovo-danger);">Worker introuvable.</div>';
        return;
      }

      workerModalTitle.textContent = prof.full_name ?? prof.id.slice(0, 8);
      const currentSkills = new Set((skills ?? []).map((s: any) => s.skill));
      const currentZones = new Set((zones ?? []).map((z: any) => z.zone));

      // Rendu des listes dispos/congés isolé, pour pouvoir rafraîchir UNIQUEMENT
      // ces blocs après ajout/suppression — réécrire toute la modale ferait perdre
      // une saisie RH non encore enregistrée (cf. revue W2).
      function availListHtml(list: any[]) {
        return list.length === 0
          ? '<div style="color:var(--bovo-muted);">Aucun créneau récurrent enregistré.</div>'
          : list.map((a: any) => `
            <div style="display:flex; justify-content:space-between; padding:6px 0; border-bottom:1px solid var(--bovo-line-soft);">
              <span><strong>${DAYS[a.day_of_week]}</strong> · ${a.time_start.slice(0, 5)} → ${a.time_end.slice(0, 5)}</span>
              <button class="del-avail" data-id="${a.id}" style="color:var(--bovo-danger); background:none; border:none; cursor:pointer;">✕</button>
            </div>`).join('');
      }
      function bkListHtml(list: any[]) {
        return list.length === 0
          ? '<div style="color:var(--bovo-muted);">Aucune indisponibilité.</div>'
          : list.map((b: any) => `
            <div style="display:flex; justify-content:space-between; padding:6px 0; border-bottom:1px solid var(--bovo-line-soft);">
              <span>${new Date(b.starts_at).toLocaleDateString('fr-FR')} → ${new Date(b.ends_at).toLocaleDateString('fr-FR')} ${b.reason ? `<em style="color:var(--bovo-muted);">— ${escapeHtml(b.reason)}</em>` : ''}</span>
              <button class="del-blackout" data-id="${b.id}" style="color:var(--bovo-danger); background:none; border:none; cursor:pointer;">✕</button>
            </div>`).join('');
      }

      workerModalBody.innerHTML = `
        <!-- INFOS -->
        <h3 style="font-family:'Jost'; font-weight:700; margin-bottom:10px;">Informations</h3>
        <div style="background:var(--bovo-bg-soft); padding:14px; border-radius:var(--r-md); margin-bottom:20px;">
          <div style="font-size:0.86rem; line-height:1.6;">
            <div><strong>${escapeHtml(prof.full_name ?? 'Sans nom')}</strong></div>
            <div style="color:var(--bovo-muted);">${escapeHtml(prof.phone ?? '—')} · Role : <span style="font-weight:600; color:${prof.role === 'admin' ? 'var(--bovo-rouge)' : 'var(--bovo-bleu)'};">${escapeHtml(prof.role)}</span></div>
          </div>
        </div>

        <!-- STATUT (W3) -->
        <h3 style="font-family:'Jost'; font-weight:700; margin-bottom:10px;">Statut</h3>
        <div style="background:var(--bovo-bg-soft); padding:14px; border-radius:var(--r-md); margin-bottom:20px;">
          <div style="display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
            <select id="status-select" class="select" style="max-width:200px;">
              <option value="active" ${(rh?.status ?? 'active') === 'active' ? 'selected' : ''}>🟢 Actif</option>
              <option value="suspended" ${rh?.status === 'suspended' ? 'selected' : ''}>🟠 Suspendu</option>
              <option value="archived" ${rh?.status === 'archived' ? 'selected' : ''}>⚫ Archivé</option>
            </select>
            <span id="status-feedback" style="font-size:0.84rem;"></span>
          </div>
          <div class="text-muted" style="font-size:0.8rem; margin-top:6px; line-height:1.4;">Un worker suspendu ou archivé n'apparaît plus dans les suggestions d'affectation ni dans « disponibles cette semaine », mais reste consultable ici.</div>
        </div>

        <!-- FICHE RH (W2) -->
        <h3 style="font-family:'Jost'; font-weight:700; margin-bottom:10px;">Fiche RH <span class="text-muted" style="font-weight:400; font-size:0.82rem;">— admin uniquement</span></h3>
        <div style="background:var(--bovo-bg-soft); padding:14px; border-radius:var(--r-md); margin-bottom:20px;">
          <div style="display:grid; grid-template-columns:repeat(2, minmax(0, 1fr)); gap:12px;">
            <div class="field" style="margin:0;">
              <label class="field-label" for="rh-hire">Date d'embauche</label>
              <input id="rh-hire" class="input" type="date" value="${escapeHtml(rh?.hire_date ?? '')}" />
            </div>
            <div class="field" style="margin:0;">
              <label class="field-label" for="rh-contract">Type de contrat</label>
              <select id="rh-contract" class="select">
                <option value="">—</option>
                <option value="freelance" ${rh?.contract_type === 'freelance' ? 'selected' : ''}>Freelance</option>
                <option value="salarie" ${rh?.contract_type === 'salarie' ? 'selected' : ''}>Salarié</option>
                <option value="essai" ${rh?.contract_type === 'essai' ? 'selected' : ''}>Période d'essai</option>
              </select>
            </div>
            <div class="field" style="margin:0;">
              <label class="field-label" for="rh-paytype">Rémunération</label>
              <select id="rh-paytype" class="select">
                <option value="">—</option>
                <option value="horaire" ${rh?.pay_type === 'horaire' ? 'selected' : ''}>Par heure</option>
                <option value="mission" ${rh?.pay_type === 'mission' ? 'selected' : ''}>Par mission</option>
              </select>
            </div>
            <div class="field" style="margin:0;">
              <label class="field-label" for="rh-rate">Tarif (XOF)</label>
              <input id="rh-rate" class="input" type="number" min="0" step="100" value="${escapeHtml(rh?.rate_xof != null ? String(rh.rate_xof) : '')}" placeholder="ex. 2500" />
            </div>
            <div class="field" style="margin:0; grid-column:1 / -1;">
              <label class="field-label" for="rh-emergency">Contact d'urgence</label>
              <input id="rh-emergency" class="input" type="text" value="${escapeHtml(rh?.emergency_contact ?? '')}" placeholder="Nom + téléphone" />
            </div>
            <div class="field" style="margin:0; grid-column:1 / -1;">
              <label class="field-label" for="rh-iddoc">Pièce d'identité (référence)</label>
              <input id="rh-iddoc" class="input" type="text" value="${escapeHtml(rh?.id_doc_ref ?? '')}" placeholder="ex. CNI n°… (le fichier viendra en W4)" />
            </div>
            <div class="field" style="margin:0; grid-column:1 / -1;">
              <label class="field-label" for="rh-note">Note interne <span class="text-muted" style="font-weight:400;">(jamais visible du client/worker)</span></label>
              <textarea id="rh-note" class="input" rows="3" style="resize:vertical;">${escapeHtml(rh?.internal_note ?? '')}</textarea>
            </div>
          </div>
          <div style="display:flex; align-items:center; gap:10px; margin-top:12px;">
            <button id="rh-save" class="btn btn-primary btn-sm" type="button">Enregistrer la fiche RH</button>
            <span id="rh-feedback" style="font-size:0.84rem;"></span>
          </div>
        </div>

        <!-- SKILLS -->
        <h3 style="font-family:'Jost'; font-weight:700; margin-bottom:10px;">Skills</h3>
        <div id="skills-list" style="display:flex; gap:8px; flex-wrap:wrap; margin-bottom:20px;">
          ${SKILLS.map((s) => `
            <button class="chip ${currentSkills.has(s) ? 'is-active' : ''}" data-skill="${s}">${SKILL_LABELS[s]}</button>
          `).join('')}
        </div>

        <!-- ZONES -->
        <h3 style="font-family:'Jost'; font-weight:700; margin-bottom:10px;">Zones d'intervention</h3>
        <div id="zones-list" style="display:flex; gap:8px; flex-wrap:wrap; margin-bottom:20px;">
          ${ZONES.map((z) => `
            <button class="chip ${currentZones.has(z) ? 'is-active' : ''}" data-zone="${z}">${z}</button>
          `).join('')}
        </div>

        <!-- DISPOS -->
        <h3 style="font-family:'Jost'; font-weight:700; margin-bottom:10px;">Disponibilités hebdomadaires</h3>
        <div id="avail-list-box" style="background:var(--bovo-bg-soft); padding:14px; border-radius:var(--r-md); margin-bottom:14px; font-size:0.84rem;">
          ${availListHtml(avail ?? [])}
        </div>
        <div style="display:flex; gap:8px; margin-bottom:20px;">
          <select id="new-avail-day" class="select" style="max-width:120px;">
            ${DAYS.map((d, i) => `<option value="${i}">${d}</option>`).join('')}
          </select>
          <input id="new-avail-start" class="input" type="time" value="08:00" style="max-width:120px;" />
          <input id="new-avail-end" class="input" type="time" value="18:00" style="max-width:120px;" />
          <button id="add-avail" class="btn btn-ghost btn-sm">+ Ajouter</button>
        </div>

        <!-- BLACKOUTS -->
        <h3 style="font-family:'Jost'; font-weight:700; margin-bottom:10px;">Congés / indispos</h3>
        <div id="bk-list-box" style="background:var(--bovo-bg-soft); padding:14px; border-radius:var(--r-md); margin-bottom:14px; font-size:0.84rem;">
          ${bkListHtml(blackouts ?? [])}
        </div>
        <div style="display:flex; gap:8px; flex-wrap:wrap; margin-bottom:20px;">
          <input id="new-bk-start" class="input" type="date" style="max-width:160px;" />
          <input id="new-bk-end" class="input" type="date" style="max-width:160px;" />
          <input id="new-bk-reason" class="input" type="text" placeholder="Motif (optionnel)" style="flex:1; min-width:180px;" />
          <button id="add-blackout" class="btn btn-ghost btn-sm">+ Ajouter</button>
        </div>

        <!-- AVIS CLIENTS -->
        <h3 style="font-family:'Jost'; font-weight:700; margin-bottom:10px;">Avis clients ${(() => {
          const list = reviewsList ?? [];
          if (list.length === 0) return '';
          const avg = (list.reduce((s: number, r: any) => s + r.rating, 0) / list.length).toFixed(1).replace('.', ',');
          return `<span style="font-weight:400; color:var(--bovo-muted); font-size:0.86rem;">— <span style="color:#f5b400;">★</span> ${avg}/5 sur ${list.length} avis</span>`;
        })()}</h3>
        <div style="background:var(--bovo-bg-soft); padding:14px; border-radius:var(--r-md); margin-bottom:20px; font-size:0.86rem;">
          ${(reviewsList ?? []).length === 0 ? '<div style="color:var(--bovo-muted);">Aucun avis client pour le moment.</div>' : (reviewsList ?? []).map((rv: any) => `
            <div style="padding:8px 0; border-bottom:1px solid var(--bovo-line-soft);">
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:4px;">
                <span style="font-weight:600;"><span style="color:#f5b400;">${'★'.repeat(rv.rating)}${'☆'.repeat(5 - rv.rating)}</span> <span style="color:var(--bovo-muted); font-weight:400;">${escapeHtml(SKILL_LABELS[rv.service_type] ?? rv.service_type)}</span></span>
                <span style="color:var(--bovo-muted); font-size:0.78rem;">${new Date(rv.created_at).toLocaleDateString('fr-FR')}</span>
              </div>
              ${rv.comment ? `<div style="color:var(--bovo-ink-soft); line-height:1.5;">${escapeHtml(rv.comment)}</div>` : '<div style="color:var(--bovo-muted); font-style:italic;">(sans commentaire)</div>'}
            </div>
          `).join('')}
        </div>

        <!-- DANGER ZONE -->
        <div style="margin-top:24px; padding-top:20px; border-top:1px solid var(--bovo-line-soft);">
          <button id="demote-btn" class="btn btn-ghost btn-sm" style="color:var(--bovo-danger);">Rétrograder en customer</button>
        </div>
      `;

      // Skills toggle
      workerModalBody.querySelectorAll<HTMLButtonElement>('[data-skill]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const skill = btn.dataset.skill!;
          const isActive = btn.classList.contains('is-active');
          if (isActive) {
            await supa.from('worker_skills').delete().eq('worker_id', id).eq('skill', skill);
          } else {
            await supa.from('worker_skills').insert({ worker_id: id, skill });
          }
          btn.classList.toggle('is-active');
          load();
        });
      });

      // Zones toggle
      workerModalBody.querySelectorAll<HTMLButtonElement>('[data-zone]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const zone = btn.dataset.zone!;
          const isActive = btn.classList.contains('is-active');
          if (isActive) {
            await supa.from('worker_zones').delete().eq('worker_id', id).eq('zone', zone);
          } else {
            await supa.from('worker_zones').insert({ worker_id: id, zone });
          }
          btn.classList.toggle('is-active');
          load();
        });
      });

      // Avail — refresh partiel (ne réécrit que la liste, préserve la saisie RH)
      function bindAvailDel() {
        document.querySelectorAll<HTMLButtonElement>('#avail-list-box .del-avail').forEach((btn) => {
          btn.addEventListener('click', async () => {
            await supa.from('worker_availability').delete().eq('id', btn.dataset.id!);
            await reloadAvail();
          });
        });
      }
      async function reloadAvail() {
        const { data } = await supa.from('worker_availability').select('*').eq('worker_id', id).order('day_of_week');
        document.getElementById('avail-list-box')!.innerHTML = availListHtml(data ?? []);
        bindAvailDel();
      }
      document.getElementById('add-avail')!.addEventListener('click', async () => {
        const day = Number((document.getElementById('new-avail-day') as HTMLSelectElement).value);
        const start = (document.getElementById('new-avail-start') as HTMLInputElement).value;
        const end = (document.getElementById('new-avail-end') as HTMLInputElement).value;
        if (!start || !end) return;
        await supa.from('worker_availability').insert({ worker_id: id, day_of_week: day, time_start: start, time_end: end });
        await reloadAvail();
      });
      bindAvailDel();

      // Blackouts — refresh partiel
      function bindBkDel() {
        document.querySelectorAll<HTMLButtonElement>('#bk-list-box .del-blackout').forEach((btn) => {
          btn.addEventListener('click', async () => {
            await supa.from('worker_blackouts').delete().eq('id', btn.dataset.id!);
            await reloadBlackouts();
          });
        });
      }
      async function reloadBlackouts() {
        const { data } = await supa.from('worker_blackouts').select('*').eq('worker_id', id).order('starts_at');
        document.getElementById('bk-list-box')!.innerHTML = bkListHtml(data ?? []);
        bindBkDel();
      }
      document.getElementById('add-blackout')!.addEventListener('click', async () => {
        const s = (document.getElementById('new-bk-start') as HTMLInputElement).value;
        const e = (document.getElementById('new-bk-end') as HTMLInputElement).value;
        const r = (document.getElementById('new-bk-reason') as HTMLInputElement).value.trim();
        if (!s || !e) return;
        await supa.from('worker_blackouts').insert({ worker_id: id, starts_at: s, ends_at: e, reason: r || null });
        (document.getElementById('new-bk-start') as HTMLInputElement).value = '';
        (document.getElementById('new-bk-end') as HTMLInputElement).value = '';
        (document.getElementById('new-bk-reason') as HTMLInputElement).value = '';
        await reloadBlackouts();
      });
      bindBkDel();

      // Statut (W3) — changement immédiat (upsert ; status seul → RH préservée)
      document.getElementById('status-select')!.addEventListener('change', async (e) => {
        const sel = e.target as HTMLSelectElement;
        const feedback = document.getElementById('status-feedback')!;
        feedback.textContent = 'Enregistrement…'; feedback.style.color = 'var(--bovo-muted)';
        const { error } = await supa.from('worker_profiles')
          .upsert({ worker_id: id, status: sel.value }, { onConflict: 'worker_id' });
        if (error) {
          feedback.textContent = `Erreur : ${error.message}`; feedback.style.color = 'var(--bovo-danger)';
        } else {
          feedback.textContent = '✓ Statut mis à jour'; feedback.style.color = '#10B981';
          load(); // rafraîchit la liste de fond (badge + filtre)
        }
      });

      // Fiche RH (W2) — enregistrement
      document.getElementById('rh-save')!.addEventListener('click', async () => {
        const feedback = document.getElementById('rh-feedback')!;
        const hire = (document.getElementById('rh-hire') as HTMLInputElement).value || null;
        const contract = (document.getElementById('rh-contract') as HTMLSelectElement).value || null;
        const payType = (document.getElementById('rh-paytype') as HTMLSelectElement).value || null;
        const rateRaw = (document.getElementById('rh-rate') as HTMLInputElement).value.trim();
        const rate = rateRaw === '' ? null : Math.max(0, Math.round(Number(rateRaw)));
        const emergency = (document.getElementById('rh-emergency') as HTMLInputElement).value.trim() || null;
        const iddoc = (document.getElementById('rh-iddoc') as HTMLInputElement).value.trim() || null;
        const note = (document.getElementById('rh-note') as HTMLTextAreaElement).value.trim() || null;

        if (rate !== null && !Number.isFinite(rate)) {
          feedback.textContent = 'Tarif invalide.'; feedback.style.color = 'var(--bovo-danger)';
          return;
        }

        const saveBtn = document.getElementById('rh-save') as HTMLButtonElement;
        saveBtn.disabled = true;
        feedback.textContent = 'Enregistrement…'; feedback.style.color = 'var(--bovo-muted)';
        // status n'est PAS dans le payload : conservé tel quel sur update, défaut 'active'
        // à l'insert (la gestion du statut relève de W3).
        const { error } = await supa.from('worker_profiles').upsert({
          worker_id: id,
          hire_date: hire,
          contract_type: contract,
          pay_type: payType,
          rate_xof: rate,
          emergency_contact: emergency,
          id_doc_ref: iddoc,
          internal_note: note,
        }, { onConflict: 'worker_id' });
        saveBtn.disabled = false;
        if (error) {
          feedback.textContent = `Erreur : ${error.message}`; feedback.style.color = 'var(--bovo-danger)';
        } else {
          feedback.textContent = '✓ Enregistré'; feedback.style.color = '#10B981';
        }
      });

      // Demote
      document.getElementById('demote-btn')!.addEventListener('click', async () => {
        if (!confirm(`Rétrograder ${prof.full_name ?? 'ce worker'} en customer ? Il/elle perdra l'accès aux fonctions worker.`)) return;
        await supa.from('profiles').update({ role: 'customer' }).eq('id', id);
        workerModal.hidden = true;
        load();
      });
    }

    async function openPromoteModal() {
      promoteErr.style.display = 'none';
      promoteSelect.innerHTML = '<option value="">Chargement…</option>';
      const { data, error } = await supa.from('profiles').select('id, full_name, phone, role').eq('role', 'customer').order('full_name').limit(200);
      if (error) {
        promoteSelect.innerHTML = `<option>Erreur : ${escapeHtml(error.message)}</option>`;
      } else if (!data || data.length === 0) {
        promoteSelect.innerHTML = '<option value="">Aucun utilisateur "customer" à promouvoir</option>';
      } else {
        promoteSelect.innerHTML = '<option value="">— Choisir un utilisateur —</option>' + data.map((u: any) => `<option value="${escapeHtml(u.id)}">${escapeHtml(u.full_name ?? '(sans nom)')} — ${escapeHtml(u.phone ?? '—')}</option>`).join('');
      }
      promoteModal.hidden = false;
    }

    document.getElementById('promote-btn')!.addEventListener('click', openPromoteModal);
    document.getElementById('promote-close')!.addEventListener('click', () => promoteModal.hidden = true);
    document.getElementById('worker-modal-close')!.addEventListener('click', () => workerModal.hidden = true);
    promoteModal.addEventListener('click', (e) => { if (e.target === promoteModal) promoteModal.hidden = true; });
    workerModal.addEventListener('click', (e) => { if (e.target === workerModal) workerModal.hidden = true; });

    document.getElementById('promote-save')!.addEventListener('click', async () => {
      const userId = promoteSelect.value;
      if (!userId) return;
      const { error } = await supa.from('profiles').update({ role: 'worker' }).eq('id', userId);
      if (error) {
        promoteErr.textContent = error.message;
        promoteErr.style.display = 'block';
        return;
      }
      promoteModal.hidden = true;
      load();
    });

    // ---- Création worker de zéro (W1) ----
    const createModal = document.getElementById('create-modal')!;
    const createForm = document.getElementById('create-form')!;
    const createSuccess = document.getElementById('create-success')!;
    const createErr = document.getElementById('create-error')!;
    const cwSkillsBox = document.getElementById('cw-skills')!;
    const cwZonesBox = document.getElementById('cw-zones')!;
    const createSaveBtn = document.getElementById('create-save') as HTMLButtonElement;
    const selectedSkills = new Set<string>();
    const selectedZones = new Set<string>();

    function renderCreateChips() {
      cwSkillsBox.innerHTML = SKILLS.map((s) =>
        `<button type="button" class="chip ${selectedSkills.has(s) ? 'is-active' : ''}" data-cw-skill="${s}">${SKILL_LABELS[s]}</button>`
      ).join('');
      cwZonesBox.innerHTML = ZONES.map((z) =>
        `<button type="button" class="chip ${selectedZones.has(z) ? 'is-active' : ''}" data-cw-zone="${escapeHtml(z)}">${escapeHtml(z)}</button>`
      ).join('');
      cwSkillsBox.querySelectorAll<HTMLButtonElement>('[data-cw-skill]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const s = btn.dataset.cwSkill!;
          if (selectedSkills.has(s)) selectedSkills.delete(s); else selectedSkills.add(s);
          btn.classList.toggle('is-active');
        });
      });
      cwZonesBox.querySelectorAll<HTMLButtonElement>('[data-cw-zone]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const z = btn.dataset.cwZone!;
          if (selectedZones.has(z)) selectedZones.delete(z); else selectedZones.add(z);
          btn.classList.toggle('is-active');
        });
      });
    }

    function openCreateModal() {
      selectedSkills.clear();
      selectedZones.clear();
      (document.getElementById('cw-name') as HTMLInputElement).value = '';
      (document.getElementById('cw-phone') as HTMLInputElement).value = '';
      (document.getElementById('cw-email') as HTMLInputElement).value = '';
      createErr.style.display = 'none';
      createForm.hidden = false;
      createSuccess.hidden = true;
      createSuccess.innerHTML = '';
      renderCreateChips();
      createModal.hidden = false;
      (document.getElementById('cw-name') as HTMLInputElement).focus();
    }

    document.getElementById('create-btn')!.addEventListener('click', openCreateModal);
    document.getElementById('create-close')!.addEventListener('click', () => createModal.hidden = true);
    createModal.addEventListener('click', (e) => { if (e.target === createModal) createModal.hidden = true; });

    createSaveBtn.addEventListener('click', async () => {
      const full_name = (document.getElementById('cw-name') as HTMLInputElement).value.trim();
      const phone = (document.getElementById('cw-phone') as HTMLInputElement).value.trim();
      const email = (document.getElementById('cw-email') as HTMLInputElement).value.trim();
      createErr.style.display = 'none';
      if (!full_name) { createErr.textContent = 'Le nom complet est requis.'; createErr.style.display = 'block'; return; }
      if (!phone) { createErr.textContent = 'Le téléphone est requis.'; createErr.style.display = 'block'; return; }

      const prevLabel = createSaveBtn.textContent ?? 'Créer le worker';
      createSaveBtn.disabled = true;
      createSaveBtn.textContent = 'Création…';
      try {
        const res = await createWorker({
          full_name, phone, email: email || undefined,
          skills: [...selectedSkills], zones: [...selectedZones],
        });
        createForm.hidden = true;
        createSuccess.hidden = false;
        const pwBlock = res.temp_password ? `
          <div style="background:var(--bovo-bg-soft); border:1px solid var(--bovo-line-soft); border-radius:var(--r-md); padding:12px; margin:12px 0;">
            <div style="font-size:0.82rem; color:var(--bovo-muted); margin-bottom:4px;">Identifiants à transmettre au worker :</div>
            <div style="font-size:0.9rem;"><strong>Email :</strong> ${escapeHtml(res.login_email)}</div>
            <div style="font-size:0.9rem; display:flex; align-items:center; gap:8px; flex-wrap:wrap; margin-top:4px;"><strong>Mot de passe :</strong> <code style="background:#fff; padding:2px 6px; border-radius:4px; border:1px solid var(--bovo-line-soft);">${escapeHtml(res.temp_password)}</code> <button id="cw-copy" class="btn btn-ghost btn-sm" type="button">Copier</button></div>
            <div style="font-size:0.78rem; color:var(--bovo-muted); margin-top:6px;">⚠️ Ce mot de passe ne sera plus affiché. À changer à la première connexion.</div>
          </div>` : `
          <div class="text-muted" style="font-size:0.86rem; margin:12px 0;">Compte « géré » créé sans email : pas de login pour l'instant (activable plus tard via l'app worker).</div>`;
        createSuccess.innerHTML = `
          <div style="text-align:center; padding:8px 0 4px;">
            <div style="font-size:2.2rem;">✅</div>
            <h3 style="font-family:'Jost'; font-weight:700; margin:6px 0;">${escapeHtml(res.full_name)} créé·e</h3>
          </div>
          ${pwBlock}
          <div style="display:flex; gap:8px; margin-top:12px; flex-wrap:wrap;">
            <button id="cw-open" class="btn btn-primary btn-sm" type="button">Ouvrir la fiche</button>
            <button id="cw-another" class="btn btn-ghost btn-sm" type="button">Créer un autre</button>
            <button id="cw-done" class="btn btn-ghost btn-sm" type="button" style="margin-left:auto;">Fermer</button>
          </div>`;
        const copyBtn = document.getElementById('cw-copy');
        if (copyBtn && res.temp_password) {
          copyBtn.addEventListener('click', async () => {
            try { await navigator.clipboard.writeText(res.temp_password!); copyBtn.textContent = 'Copié ✓'; } catch { /* clipboard indispo */ }
          });
        }
        document.getElementById('cw-open')!.addEventListener('click', () => { createModal.hidden = true; openWorkerModal(res.worker_id); });
        document.getElementById('cw-another')!.addEventListener('click', openCreateModal);
        document.getElementById('cw-done')!.addEventListener('click', () => { createModal.hidden = true; });
        load();
      } catch (err: any) {
        createErr.textContent = err?.message ?? 'Échec de la création.';
        createErr.style.display = 'block';
      } finally {
        createSaveBtn.disabled = false;
        createSaveBtn.textContent = prevLabel;
      }
    });

    let searchTimer: any;
    searchInput.addEventListener('input', () => {
      clearTimeout(searchTimer);
      searchTimer = setTimeout(load, 250);
    });
    document.getElementById('active-only')!.addEventListener('change', load);

    await load();
  }
</script>
