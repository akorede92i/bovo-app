---
import '@styles/global.css';
import { ViewTransitions } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  topbar?: 'logo' | 'back' | 'none';
  backHref?: string;
  pageTitle?: string;
  noindex?: boolean;
  /**
   * Type de shell :
   * - 'app' (défaut) : carte mobile centrée (forms, auth, tunnels)
   * - 'landing'      : pleine largeur responsive (homepage, pages marketing)
   * - 'tunnel'       : comme 'app' mobile + 2 colonnes desktop si slot="sidebar"
   * - 'dashboard'    : sidebar nav + content (compte/*)
   */
  shell?: 'app' | 'landing' | 'tunnel' | 'dashboard';
  /**
   * Active les View Transitions (navigation client app-like) sur cette page.
   * Opt-in par page : la navigation entre 2 pages avec transitions=true est
   * fluide, sinon Astro fait un rechargement complet (fallback sûr).
   * IMPORTANT : tout script de page doit être (ré)initialisé sur
   * `astro:page-load` et court-circuiter si son élément racine est absent.
   */
  transitions?: boolean;
}

const {
  title = 'Bovo — Réservez votre prestation à Cotonou',
  description = 'Réservez en ligne ménage, déménagement, chef à domicile et service Airbnb à Cotonou, Calavi, Porto-Novo. Tarifs clairs, prestataires vérifiés, WhatsApp à portée de main.',
  topbar = 'logo',
  backHref,
  pageTitle,
  noindex = false,
  shell = 'app',
  transitions = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://app.bovo.bj').toString();
---
<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5, viewport-fit=cover" />

    <!-- Garde-fou recovery password : si un lien Supabase atterrit ailleurs
         que /auth/reset/, on redirige en préservant le hash. -->
    <script is:inline>
      (function () {
        var hash = window.location.hash || '';
        var path = window.location.pathname || '';
        if (hash.indexOf('type=recovery') !== -1 && path.indexOf('/auth/reset') === -1) {
          window.location.replace('/auth/reset/' + hash);
        }
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonical} />

    <!-- Theme color (bleu Bovo) -->
    <meta name="theme-color" content="#4470B3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#345a8f" media="(prefers-color-scheme: dark)" />

    <!-- PWA -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Bovo" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Bovo" />
    <meta property="og:locale" content="fr_BJ" />
    <meta property="og:image" content="https://bovo.bj/og-image.png" />

    <meta name="twitter:card" content="summary_large_image" />

    <!-- Preconnects + fonts (link plutôt que @import : non bloquant après parse CSS) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Jost:wght@500;600;700;800&family=Montserrat:wght@400;500;600;700&display=swap"
    />

    {transitions && <ViewTransitions />}

    <slot name="head" />
  </head>
  <body data-shell={shell}>
    <a href="#main-content" class="skip-link">Aller au contenu</a>
    {shell === 'landing' ? (
      <!-- ====== LANDING SHELL : full-width responsive ====== -->
      <div class="landing-shell">
        <header class="landing-header">
          <div class="landing-header-inner">
            <a href="/" class="bovo-logo" aria-label="Bovo — Accueil">B<span class="o-rouge">O</span>VO</a>
            <nav class="landing-nav" aria-label="Navigation principale">
              <a href="#services">Services</a>
              <a href="#fonctionnement">Comment ça marche</a>
              <a href="https://wa.me/2290196677743" target="_blank" rel="noopener">Support</a>
            </nav>
            <div class="landing-cta">
              <a href="/compte/connexion/" class="landing-login">Se connecter</a>
              <a href="/compte/inscription/" class="btn btn-primary btn-sm">Créer un compte</a>
            </div>
            <button class="landing-burger" id="landing-burger" aria-label="Menu" type="button">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
            </button>
          </div>
        </header>
        <main id="main-content" class="landing-main">
          <slot />
        </main>
        <slot name="cta-footer" />
      </div>
    ) : shell === 'dashboard' ? (
      <!-- ====== DASHBOARD SHELL : sidebar nav + content ====== -->
      <div class="dash-shell">
        <header class="dash-topbar">
          <button class="dash-burger" id="dash-burger" aria-label="Menu" type="button">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
          </button>
          <a href="/" class="bovo-logo" aria-label="Bovo — Accueil">B<span class="o-rouge">O</span>VO</a>
          {pageTitle && <span class="dash-topbar-title">{pageTitle}</span>}
          <div style="flex:1;"></div>
          <a href="/" class="dash-topbar-back" aria-label="Retour à l'app">← App</a>
        </header>
        <div class="dash-body">
          <aside class="dash-sidebar" id="dash-sidebar">
            <slot name="sidebar" />
          </aside>
          <main id="main-content" class="dash-main">
            <slot />
          </main>
        </div>
        <slot name="cta-footer" />
      </div>
    ) : (
      <!-- ====== APP / TUNNEL SHELL : mobile-card centré ====== -->
      <div class={shell === 'tunnel' ? 'app app-tunnel' : 'app'}>
        {topbar !== 'none' && (
          <header class="topbar">
            <div class="topbar-inner">
              {topbar === 'back' ? (
                <a href={backHref ?? '/'} class="topbar-back" aria-label="Retour">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M19 12H5" /><path d="M12 19l-7-7 7-7" />
                  </svg>
                </a>
              ) : (
                <a href="/" class="bovo-logo" aria-label="Bovo — Accueil">B<span class="o-rouge">O</span>VO</a>
              )}
              {pageTitle && <span class="topbar-title">{pageTitle}</span>}
              <div class="topbar-spacer"></div>
            </div>
            <slot name="topbar-extra" />
          </header>
        )}

        {shell === 'tunnel' ? (
          <div class="tunnel-grid">
            <main id="main-content" class="page tunnel-main">
              <slot />
            </main>
            <aside class="tunnel-aside">
              <slot name="sidebar" />
            </aside>
          </div>
        ) : (
          <main id="main-content" class="page">
            <slot />
          </main>
        )}

        <slot name="cta-footer" />
      </div>
    )}

    <!-- Register PWA service worker (web only — désactivé dans l'app native
         Capacitor, où il entrerait en conflit avec le serveur local). -->
    <script is:inline>
      (function () {
        var isNative = !!(window.Capacitor && window.Capacitor.isNativePlatform && window.Capacitor.isNativePlatform());
        if (!isNative && 'serviceWorker' in navigator) {
          window.addEventListener('load', function () {
            navigator.serviceWorker.register('/sw.js').catch(function () {});
          });
        }
      })();
    </script>

    <!-- Initialisation des fonctionnalités natives (no-op sur le web). -->
    <script>
      import { initNative } from '@lib/native';
      initNative();
    </script>

    <!-- Mobile drawer toggle (landing + dashboard shells) -->
    <script>
      const DRAWERS = [
        { burgerId: 'landing-burger', openClass: 'landing-drawer-open', linksSel: '.landing-nav a, .landing-cta a' },
        { burgerId: 'dash-burger', openClass: 'dash-drawer-open', linksSel: '.dash-sidebar a' },
      ];

      function closeDrawers() {
        for (const { burgerId, openClass } of DRAWERS) {
          document.body.classList.remove(openClass);
          document.getElementById(burgerId)?.setAttribute('aria-expanded', 'false');
        }
      }

      function initDrawers() {
        for (const { burgerId, openClass, linksSel } of DRAWERS) {
          const burger = document.getElementById(burgerId);
          // Garde anti-double-bind : astro:page-load se déclenche aussi au premier
          // chargement quand le routeur View Transitions est présent.
          if (!burger || burger.dataset.bound) continue;
          burger.dataset.bound = 'true';
          burger.setAttribute('aria-expanded', 'false');
          burger.addEventListener('click', () => {
            const open = document.body.classList.toggle(openClass);
            burger.setAttribute('aria-expanded', String(open));
          });
          document.querySelectorAll(linksSel).forEach((a) => {
            a.addEventListener('click', closeDrawers);
          });
        }
      }

      initDrawers();
      // Ré-initialisation après une navigation View Transitions (le DOM est
      // remplacé, les listeners des anciens éléments sont perdus).
      document.addEventListener('astro:page-load', initDrawers);

      // L'overlay est un ::before du body : un clic dessus cible <body> → fermeture.
      document.addEventListener('click', (e) => {
        if (e.target === document.body) closeDrawers();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeDrawers();
      });
    </script>
  </body>
</html>
