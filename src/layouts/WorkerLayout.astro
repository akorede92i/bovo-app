---
import '@styles/global.css';

interface Props {
  title?: string;
  pageTitle?: string;
}
const { title = 'Espace worker — Bovo', pageTitle } = Astro.props;
const path = Astro.url.pathname;
const isMissions = path === '/worker' || path === '/worker/';
const isDispo = path.startsWith('/worker/disponibilites');
---
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="robots" content="noindex,nofollow" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="theme-color" content="#4470B3" />

  <!-- Polices Bovo (Jost titres + Montserrat corps) — WorkerLayout n'étend pas Layout.astro,
       il doit donc charger les polices lui-même (page racine de l'app native worker). -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Jost:wght@500;600;700;800&family=Montserrat:wght@400;500;600;700&display=swap" />

  <style>
    body { background: var(--bovo-bg-soft) !important; }
    .worker-shell {
      max-width: 560px;
      margin: 0 auto;
      min-height: 100vh;
      min-height: 100dvh;
      background: var(--bovo-bg);
    }
    .worker-header {
      position: sticky;
      top: 0;
      z-index: var(--z-sticky);
      background: var(--bovo-bleu);
      color: #fff;
      padding: 14px 18px;
      padding-top: calc(14px + env(safe-area-inset-top));
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .worker-header .worker-logo {
      font-family: 'Jost', sans-serif;
      font-weight: 800;
      font-size: 1.15rem;
      letter-spacing: 1.5px;
      color: #fff;
      text-decoration: none;
    }
    /* O de marque atténué sur fond bleu (même traitement que l'admin). */
    .worker-header .worker-logo .o-rouge { color: #fff; opacity: 0.72; }
    .worker-header .worker-pill {
      font-size: 0.64rem;
      font-weight: 700;
      letter-spacing: 1.2px;
      background: rgba(255,255,255,0.18);
      color: #fff;
      padding: 3px 9px;
      border-radius: var(--r-full);
      text-transform: uppercase;
      margin-left: 8px;
    }
    .worker-header #worker-signout {
      font-size: 0.82rem;
      color: rgba(255,255,255,0.85);
      text-decoration: none;
      background: none;
      border: none;
      padding: 0;
      cursor: pointer;
      font-family: inherit;
    }
    .worker-nav {
      display: flex;
      background: var(--bovo-bg);
      border-bottom: 1px solid var(--bovo-line-soft);
      position: sticky;
      top: calc(52px + env(safe-area-inset-top));
      z-index: var(--z-sticky);
    }
    .worker-nav a {
      flex: 1;
      text-align: center;
      padding: 12px 8px;
      font-size: 0.9rem;
      font-weight: 600;
      color: var(--bovo-muted);
      text-decoration: none;
      border-bottom: 2px solid transparent;
    }
    .worker-nav a.is-active { color: var(--bovo-bleu); border-bottom-color: var(--bovo-bleu); }
    .worker-page { padding: 18px 16px calc(32px + env(safe-area-inset-bottom)); }
    .worker-h1 { font-family: 'Jost', sans-serif; font-weight: 800; font-size: 1.3rem; margin-bottom: 4px; }
  </style>
</head>
<body>
  <div class="worker-shell">
    <header class="worker-header">
      <div style="display:flex; align-items:center;">
        <a href="/worker/" class="worker-logo">B<span class="o-rouge">O</span>VO</a>
        <span class="worker-pill">Worker</span>
      </div>
      <button type="button" id="worker-signout">Déconnexion</button>
    </header>

    <nav class="worker-nav">
      <a href="/worker/" class={isMissions ? 'is-active' : ''}>Mes missions</a>
      <a href="/worker/disponibilites/" class={isDispo ? 'is-active' : ''}>Mes dispos</a>
    </nav>

    <main class="worker-page">
      {pageTitle && <h1 class="worker-h1">{pageTitle}</h1>}
      <slot />
    </main>
  </div>

  <script>
    import { requireWorker, signOut } from '@lib/auth';
    import { ensurePushRegistered } from '@lib/native';

    await requireWorker();
    // Push : rattache le jeton + demande la permission (no-op web, actif natif).
    void ensurePushRegistered();

    document.getElementById('worker-signout')!.addEventListener('click', (e) => {
      e.preventDefault();
      // Rester dans le périmètre worker (sinon l'app native « Bovo Pro » afficherait
      // la vitrine client au lieu de l'écran de connexion worker).
      signOut('/compte/connexion/?next=/worker/');
    });
  </script>
</body>
</html>
