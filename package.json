{
  "name": "bovo-app",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "android:assets": "npx @capacitor/assets generate --android",
    "cap:client:add": "npm run build && BOVO_APP=client npx cap add android",
    "cap:client:sync": "npm run build && BOVO_APP=client npx cap sync android",
    "cap:client:open": "BOVO_APP=client npx cap open android",
    "cap:worker:add": "npm run build && BOVO_APP=worker npx cap add android",
    "cap:worker:sync": "npm run build && BOVO_APP=worker npx cap sync android",
    "cap:worker:open": "BOVO_APP=worker npx cap open android"
  },
  "dependencies": {
    "@astrojs/sitemap": "~3.2.1",
    "@capacitor-firebase/app": "^8.3.0",
    "@capacitor-firebase/messaging": "^8.3.0",
    "@capacitor/android": "^8.4.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/ios": "^8.4.0",
    "@capacitor/keyboard": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@supabase/supabase-js": "^2.45.4",
    "astro": "^4.16.0",
    "firebase": "^12.14.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^2.1.9",
    "jsdom": "^29.1.1",
    "vitest": "^2.1.9"
  }
}
